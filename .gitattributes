# 文本统一以 LF 保存到 Git，二进制几何和验证图片保持原样。
* text=auto
*.m text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.py text eol=lf
*.stl binary
*.png binary
*.mat binary
*.pdf binary

# 追溯资料保留原始字节，避免自动换行破坏已有SHA校验。
tests/data/**/raw/** -text -eol
docs/validation/storage_20261028/preserved_v85_candidate/** -text -eol
docs/validation/storage_20261028/outputs_cleanup_plan.json -text -eol
docs/validation/v91/raw/** -text -eol
# 清理回执互相引用原文件SHA，保留计划、日志及历史源码的原字节。
docs/validation/storage_20261028/followup/** -text -eol
*.json.gz binary
# 数值/浏览器验证回执互相引用SHA，保存v92原始字节。
docs/validation/v92/** -text -eol
*.jpg binary
# 样式URL使用已验收CSS的内容SHA，保留该资源原始换行字节。
web/viewer.css -text -eol
