# 本地计算输出、日志与发布包；正式验证资料保留在 docs/validation。
/outputs/
/dist/
/releases/
/tools/runtime/
*.log
!docs/validation/v105/**/*.log
!docs/validation/v106/**/*.log
!docs/validation/v107/**/*.log
!docs/validation/v108/**/*.log

# MATLAB 自动保存与会话文件。
*.asv
*.m~
matlab.mat
MATLABDesktop.xml

# 本地密钥与环境配置不得纳入版本库。
.env
.env.*
!.env.example
*.pem
*.key

# 编辑器、系统和 Python 缓存。
.DS_Store
Thumbs.db
__pycache__/
*.pyc
.vscode/
.idea/
