function info=buildSU2FlatPlateCase(folder,options)
%BUILDSU2FLATPLATECASE 直接生成二维可压缩等温平板体网格及SU2输入。
% 模块一：明确测试几何与SI单位，流向-X，前缘X=0，上游X>0。
% 模块二：靠壁拉伸四边形网格，前缘前为对称面，入口/上边界为远场。
% 模块三：定比热空气、Sutherland黏性与常Pr；独立验证用，不伪装真实箭体。
if nargin<2,options=struct;end
o=struct('nx',80,'ny',64,'firstCellHeight',2e-6,'height',.06, ...
    'length',.2,'upstreamLength',.04,'Mach',4,'temperature',300, ...
    'pressure',5000,'wallTemperature',300,'iterations',2500);
for name=fieldnames(options)'
    assert(isfield(o,name{1}),'RocketAeroHeat:SU2:Option','未知平板选项。');o.(name{1})=options.(name{1});
end
validateattributes(o.nx,{'numeric'},{'scalar','integer','>=',24,'<=',512});
validateattributes(o.ny,{'numeric'},{'scalar','integer','>=',24,'<=',256});
for name={'firstCellHeight','height','length','upstreamLength','Mach','temperature','pressure','wallTemperature','iterations'}
    validateattributes(o.(name{1}),{'numeric'},{'real','finite','scalar','positive'});
end
assert(o.Mach>1 && o.firstCellHeight*o.ny<o.height && o.iterations==fix(o.iterations));
assert(~exist(folder,'dir'),'RocketAeroHeat:SU2:Existing','使用新目录，禁止覆盖历史结果。');mkdir(folder);
% 前缘后流向二次拉伸使第一站足够近；精确保留s=0，避免对称/等温边界错位。
up=max(8,round(o.nx*.2));down=o.nx-up;
s=[linspace(-o.upstreamLength,0,up+1),o.length*((1:down)/down).^1.5];
ratio=fzero(@(r)o.firstCellHeight*sum(r.^(0:o.ny-1))-o.height,[1 2]);
y=[0 cumsum(o.firstCellHeight*ratio.^(0:o.ny-1))];
nx=numel(s);ny=numel(y);[S,Y]=ndgrid(s,y);V=[-S(:),Y(:)];
index=@(i,j)(j-1)*nx+i-1; % SU2使用从0开始的节点编号。
F=zeros((nx-1)*(ny-1),4);k=0;
for j=1:ny-1
    for i=1:nx-1
        k=k+1;F(k,:)=[index(i,j),index(i,j+1),index(i+1,j+1),index(i+1,j)];
    end
end
signedArea=zeros(size(F,1),1);
for j=1:4
    a=V(F(:,j)+1,:);b=V(F(:,mod(j,4)+1)+1,:);
    signedArea=signedArea+(a(:,1).*b(:,2)-a(:,2).*b(:,1))/2;
end
assert(all(signedArea>0) && abs(sum(signedArea)-(o.length+o.upstreamLength)*o.height)<1e-12);
bottom=[(1:nx-1)' (0:nx-2)'];wall=bottom(s(1:end-1)>=0,:);sym=bottom(s(1:end-1)<0,:);
far=[arrayfun(@(j)[index(1,j),index(1,j+1)],(1:ny-1)','UniformOutput',false); ...
    arrayfun(@(i)[index(i,ny),index(i+1,ny)],(1:nx-1)','UniformOutput',false)];far=vertcat(far{:});
outlet=cell2mat(arrayfun(@(j)[index(nx,j+1),index(nx,j)],(1:ny-1)','UniformOutput',false));
fid=fopen(fullfile(folder,'mesh.su2'),'w');assert(fid>=0);guard=onCleanup(@()fclose(fid));
fprintf(fid,'NDIME= 2\nNELEM= %d\n',size(F,1));fprintf(fid,'9 %d %d %d %d\n',F');
fprintf(fid,'NPOIN= %d\n',size(V,1));fprintf(fid,'%.17g %.17g %d\n',[V,(0:size(V,1)-1)']');
fprintf(fid,'NMARK= 4\n');markers={wall,sym,far,outlet};names={'wall','symmetry','farfield','outlet'};
for j=1:4
    fprintf(fid,'MARKER_TAG= %s\nMARKER_ELEMS= %d\n',names{j},size(markers{j},1));
    fprintf(fid,'3 %d %d\n',markers{j}');
end
clear guard;
% 明确单位和热物性，不使用SU2默认雷诺数反推压力。
R=287.05287;gamma=1.4;muRef=1.458e-6*273.15^1.5/(273.15+110.4);
cfg={ 'SOLVER= NAVIER_STOKES';'KIND_TURB_MODEL= NONE';'MATH_PROBLEM= DIRECT'; ...
    'RESTART_SOL= NO';'MESH_FILENAME= mesh.su2';'MESH_FORMAT= SU2'; ...
    'SYSTEM_MEASUREMENTS= SI';'REF_DIMENSIONALIZATION= DIMENSIONAL'; ...
    'FLUID_MODEL= IDEAL_GAS';sprintf('GAMMA_VALUE= %.17g',gamma);sprintf('GAS_CONSTANT= %.17g',R); ...
    'INIT_OPTION= TD_CONDITIONS';sprintf('MACH_NUMBER= %.17g',o.Mach);'AOA= 180.0';'SIDESLIP_ANGLE= 0.0'; ...
    sprintf('FREESTREAM_TEMPERATURE= %.17g',o.temperature);sprintf('FREESTREAM_PRESSURE= %.17g',o.pressure); ...
    'VISCOSITY_MODEL= SUTHERLAND';sprintf('MU_REF= %.17g',muRef);'MU_T_REF= 273.15';'SUTHERLAND_CONSTANT= 110.4'; ...
    'CONDUCTIVITY_MODEL= CONSTANT_PRANDTL';'PRANDTL_LAM= 0.72'; ...
    sprintf('MARKER_ISOTHERMAL= (wall, %.17g)',o.wallTemperature);'MARKER_SYM= (symmetry)'; ...
    'MARKER_FAR= (farfield)';'MARKER_SUPERSONIC_OUTLET= (outlet)'; ...
    'MARKER_PLOTTING= (wall)';'MARKER_MONITORING= (wall)';'REF_AREA= 0.2'; ...
    'NUM_METHOD_GRAD= WEIGHTED_LEAST_SQUARES';'CONV_NUM_METHOD_FLOW= AUSM'; ...
    'MUSCL_FLOW= YES';'SLOPE_LIMITER_FLOW= VENKATAKRISHNAN_WANG';'VENKAT_LIMITER_COEFF= 0.05'; ...
    'TIME_DISCRE_FLOW= EULER_IMPLICIT';'LINEAR_SOLVER= BCGSTAB';'LINEAR_SOLVER_PREC= LU_SGS'; ...
    'LINEAR_SOLVER_ERROR= 1E-5';'LINEAR_SOLVER_ITER= 10';'MGLEVEL= 0'; ...
    'CFL_NUMBER= 0.5';'CFL_ADAPT= YES';'CFL_ADAPT_PARAM= (0.5, 1.1, 0.1, 10.0)'; ...
    sprintf('ITER= %d',o.iterations);'CONV_FIELD= (RMS_DENSITY, RMS_ENERGY)'; ...
    'CONV_RESIDUAL_MINVAL= -8';'CONV_STARTITER= 10';'TABULAR_FORMAT= CSV'; ...
    'CONV_FILENAME= history';'SURFACE_FILENAME= surface_flow';'RESTART_FILENAME= restart_flow'; ...
    'VOLUME_FILENAME= volume_flow';'OUTPUT_FILES= (SURFACE_CSV, RESTART_ASCII)'; ...
    sprintf('OUTPUT_WRT_FREQ= %d',o.iterations);'WRT_RESTART_OVERWRITE= YES'; ...
    'WRT_SURFACE_OVERWRITE= YES';'SCREEN_WRT_FREQ_INNER= 50'; ...
    'SCREEN_OUTPUT= (INNER_ITER, RMS_DENSITY, RMS_MOMENTUM-X, RMS_MOMENTUM-Y, RMS_ENERGY, DRAG)'; ...
    'VOLUME_OUTPUT= (COORDINATES, SOLUTION, PRIMITIVE)'};
fid=fopen(fullfile(folder,'case.cfg'),'w','n','UTF-8');assert(fid>=0);guard=onCleanup(@()fclose(fid));
fprintf(fid,'%s\n',cfg{:});clear guard;
info=struct('options',o,'vertices',size(V,1),'cells',size(F,1),'minimumCellArea',min(signedArea), ...
    'totalArea',sum(signedArea),'stretchRatio',ratio,'coordinates','X=-s; leading edge X=0; SI', ...
    'thermalPropertyMode','caloricallyPerfect','gamma',gamma,'R',R,'Prandtl',.72, ...
    'source','SU2 v8.6.0 public supersonic flatplate configuration syntax; project-generated geometry/conditions', ...
    'experimentalValidation',false,'productionQualified',false);
fid=fopen(fullfile(folder,'case_manifest.json'),'w','n','UTF-8');assert(fid>=0);guard=onCleanup(@()fclose(fid));
fprintf(fid,'%s\n',jsonencode(info));
end
