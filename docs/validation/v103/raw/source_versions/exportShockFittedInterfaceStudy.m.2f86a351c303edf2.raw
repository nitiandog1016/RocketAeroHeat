function report=exportShockFittedInterfaceStudy(capFiles,capAudits,legacyFile,legacyAudit,folder)
%EXPORTSHOCKFITTEDINTERFACESTUDY 在统一科研界面比较实际界面方法和法向网格敏感性。
% 模块一：每个候选绑定独立审核，读取真实初末帧；完整箭体仅作未求场量的几何参照。
% 模块二：云图字段统一由当前帧五量与几何派生，壁压不复用上一时间步的旧采样值。
% 模块三：末步RH通量缺陷、压力相容差和运动误差单列，明确输入态及平均几何的时间。
% 模块四：所有热流和热学温度保持真实未知；数值诊断不授予区域资格或新增面积。
assert(iscell(capFiles)&&iscell(capAudits)&&numel(capFiles)==numel(capAudits)&&~isempty(capFiles), ...
    'ShockFit:InterfaceExportSource','每个实际MAT须对应同源独立审核。');
exportShockFittedKernelStudy(legacyFile,legacyAudit,folder);
web=fullfile(folder,'workbench');data=jsondecode(fileread(fullfile(web,'ale-data.json')));
geometrySource=data.source;cases=cell(numel(capFiles),1);
for j=1:numel(capFiles)
    saved=load(capFiles{j},'study');s=saved.study;check=jsondecode(fileread(capAudits{j}));
    assert(strcmp(check.status,'passed-independent-interface-transient-and-current-frame-wall-audit-not-region-qualification')&& ...
        strcmp(check.evidenceSHA256,rocketStreamingFileSHA256(capFiles{j}))&&~check.productionQualified&& ...
        ~s.productionQualified,'ShockFit:InterfaceExportSource','缺少对应实际结果的独立界面审核。');
    motion='face-riemann-L2';flux='RH';
    assert(all(s.upstream.velocityVector(2:3)==0)&&s.upstream.velocityVector(1)<0, ...
        'ShockFit:InterfaceExportScope','本对照页只接受来流−X的零攻角独立球鼻，不把其他工况标成零攻角。');
    if isfield(s,'motionMethod'),motion=s.motionMethod;end
    if isfield(s,'shockFluxMethod'),flux=s.shockFluxMethod;end
    shell=s.cap.shell;mesh=shell.mesh;b=mesh.boundaryFaces;
    first=currentFrame(s.initialNodes,s.initialQ,0,shell,s.gas, ...
        '初始外壳的RH初始化状态及其派生壁压；不是已求出的稳态外流');
    last=currentFrame(s.nodes,s.Q,s.timeS,shell,s.gas, ...
        '当前保存帧的非稳态五量和派生壁压；仍未通过工程区域资格');
    first.diagnostics=struct('available',false);
    last.diagnostics=stepDiagnostics(s);
    if strcmp(motion,'nodal-characteristic'),motionLabel='共享节点J+相容';else,motionLabel='逐面Riemann / 全局射线L²投影';end
    if strcmp(flux,'upstream-riemann'),fluxLabel='实际移动面Riemann通量';else,fluxLabel='原RH强制通量';end
    names=struct('pressurePa',['当前帧五量恢复常gamma单元压力；' motionLabel '；' fluxLabel], ...
        'temperatureK','当前帧密度/总能量恢复常gamma流体温度；不是Te、Tr或壁温', ...
        'speedMS','当前保存帧三维动量/密度的速度幅值；保留横向分量', ...
        'wallPressurePa','当前帧五量 / 当前固定三角壁面法向 / 零壁速镜像精确Riemann派生压力；与当前帧同一时刻', ...
        'heatFluxWm2','未计算黏性热流；无黏模型不能以零值代替气动热结果', ...
        'wallTemperatureK','未求解壁体温度；流体温度不充当求解壁温', ...
        'edgeTemperatureK','尚无合格边界层外缘匹配；层内温度不充当Te', ...
        'recoveryTemperatureK','未计算恢复温度或恢复焓', ...
        'inputWallTemperatureK','本无黏研究未设置壁温边界');
    source=struct('evidenceFile',strrep(capFiles{j},'\','/'),'evidenceSHA256',check.evidenceSHA256, ...
        'auditFile',strrep(capAudits{j},'\','/'),'auditSHA256',rocketStreamingFileSHA256(capAudits{j}));
    cases{j}=struct('id',sprintf('sphere-%s-%s-L%d',motion,flux,shell.layers), ...
        'caption',sprintf('%s · %s · %d层',motionLabel,fluxLabel,shell.layers), ...
        'faces',mesh.faces(b,:)-1,'boundaryKind',s.boundary.kind, ...
        'sourceFaceIDs',shell.cellOriginalFaceIDs(mesh.owner(b)), ...
        'sourceFaceLabel','所属球鼻基准面号（非原箭体）','frames',{{first,last}}, ...
        'methods',names,'source',source,'pressureRangePa',[0 45000], ...
        'defaultView','wall','defaultField','wallPressurePa','timeKind','transient', ...
        'conditionLabel',sprintf('M=%.6g；α=0°；R=%.6g m；%d个壁面 / %d个单元；常gamma',norm(s.upstream.velocityVector)/s.upstreamSoundSpeedMS,s.cap.radiusM,size(s.cap.F,1),mesh.cellCount), ...
        'modelRole','独立参数化球鼻；原20°输入只复用p/T/rho/R和速率', ...
        'scope','有限60°球鼻非稳态候选；原10微米几何、激波相容、稳态及网格/外域条件未通过', ...
        'stateRole','初态为初始化；末态为实际三维推进候选；热流、Te/Tr和壁温仍未求', ...
        'fieldStateLabel','实际保存的未稳态研究值；不授予区域资格', ...
        'coordinateNote','SI / m · 球鼻+X、零攻角来流−X；球鼻面号不冒充原箭体面号', ...
        'geometryNote','当前帧压力与派生壁压；热流灰色为未求；截面交线不是流线', ...
        'boundaryDescription',['固定滑移壁面 / ' fluxLabel ' / 仅全部特征出流的侧边界'], ...
        'unsolvedNote','激波前沿、稳态、精确壁面与网格/外域验证仍未收口；不能作为合格气动热外缘', ...
        'diagnostic',sprintf('%d步；变化率%.4g；末步压力相容差%.4g；独立RH通量缺陷%.4g；面速度残差%.4g m/s。', ...
            check.acceptedSteps,check.finalResidual,check.finalShockPressureMismatch, ...
            check.lastStep.maximumIndependentRHFluxDefect,check.sharedNodeMotion.maximumUnrepresentedFaceSpeedMS), ...
        'motionMethod',motion,'shockFluxMethod',flux,'productionQualified',false);
end
data.kind='shock-fitted-interface-study-v103';data.cases=cases;
data.originalGeometrySource=geometrySource;data.originalCaseIndex=0;
data.originalGeometryConditionLabel='原20°整箭几何参照；本页没有对应物理场或物理时刻';
data.defaultCaseIndex=min(2,numel(cases)-1);data.source=cases{data.defaultCaseIndex+1}.source;
data.NASA7Scope='本页只采用明确的常gamma三维ALE候选；NASA7动态未实现。所有区域资格仍为false，新增正式热流面积0。';
data.timeSemantics='主体云图、探针和周向曲线均采用所选当前保存帧；末步通量诊断另列输入态时刻及几何时间段。';
text=jsonencode(data);write(fullfile(web,'ale-data.json'),text);write(fullfile(web,'ale-data.js'),['window.ALE_STUDY=' text ';' newline]);
report=struct('status','exported-interface-method-comparison-with-current-frame-wall-and-separate-step-diagnostics', ...
    'cases',numel(cases),'frames',2*numel(cases),'dataSHA256',rocketStreamingFileSHA256(fullfile(web,'ale-data.json')), ...
    'wallPressureFromCurrentFrame',true,'lastStepDiagnosticTimesSeparated',true, ...
    'productionQualified',false,'newProductionSolvedAreaM2',0);
write(fullfile(folder,'interface_export.json'),jsonencode(report));disp(report);
end

function f=currentFrame(X,Q,time,shell,gas,role)
% 模块五：只做当前状态的派生量恢复，不重新推进流场；壁压与其他主体字段同一时刻。
mesh=shell.mesh;b=mesh.boundaryFaces;owner=mesh.owner(b);N=numel(b);empty=nan(N,1);
state=shockFittedState3D(Q,gas,'conservative');geo=shockFittedALEGeometry(mesh,X,X,1);
walls=find(shell.wallBoundaryMask);wall=empty;
[~,audit]=shockFittedSlipWallFlux3D(Q(owner(walls),:),geo.normal(b(walls),:),zeros(numel(walls),1),gas);
wall(walls)=audit.pressurePa;
f=struct('position',X,'pressurePa',state.pressure(owner),'temperatureK',state.temperature(owner), ...
    'speedMS',vecnorm(state.velocity(owner,:),2,2),'wallPressurePa',wall, ...
    'heatFluxWm2',empty,'wallTemperatureK',empty,'edgeTemperatureK',empty, ...
    'recoveryTemperatureK',empty,'inputWallTemperatureK',empty,'timeS',time, ...
    'wallPressureTimeS',time,'wallPressureValueRole','当前帧状态派生的Riemann壁面迹；不是独立稳态解', ...
    'valueRole',role);
end

function d=stepDiagnostics(s)
% 模块六：原单元压力差和五量通量缺陷分别保留，RH恒等零不冒充相容或稳态通过。
shell=s.cap.shell;mesh=shell.mesh;b=mesh.boundaryFaces;N=numel(b);outer=find(shell.outerBoundaryMask);
faces=b(outer);step=s.lastStep;g=step.geometry;up=s.upstream;gas=s.gas;
state=shockFittedState3D([up.density up.velocityVector' up.temperature],gas,'primitive');
normal=g.normal(faces,:);D=g.gridNormalSpeedMS(faces);un=normal*state.velocity';
reference=[up.density*un,up.density*un.*state.velocity+up.pressure*normal, ...
    (state.Q(5)+up.pressure)*un]-D.*state.Q;
speed=max(norm(up.velocityVector),state.soundSpeed);
scale=up.density*[speed repmat(speed^2,1,3) speed^3];
defect=nan(N,5);defect(outer,:)=(step.faceALEFlux(faces,:)-reference)./scale;
projected=nan(N,1);requested=projected;residual=projected;average=projected;trace=projected;
projected(outer)=s.lastMotion.faceNormalSpeedMS;requested(outer)=s.lastMotion.requestedFaceNormalSpeedMS;
residual(outer)=s.lastMotion.projectionResidualMS;average(outer)=g.gridNormalSpeedMS(faces);
if isfield(step,'shockReconstructedPressureRelativeMismatch'),trace=step.shockReconstructedPressureRelativeMismatch;end
dt=s.history(end,2);inputTime=s.timeS-dt;
d=struct('available',true,'inputTimeS',inputTime,'geometryTimeSpanS',[inputTime s.timeS], ...
    'cellPressureMismatch',step.shockInteriorPressureRelativeMismatch,'RHFluxDefect5',defect, ...
    'requestedFaceSpeedMS',requested,'projectedFaceSpeedMS',projected,'faceSpeedResidualMS',residual, ...
    'stepAverageGridNormalSpeedMS',average,'reconstructedPressureMismatch',trace, ...
    'stepInputWallPressurePa',step.wallPressurePa, ...
    'pressureMethod','末步输入单元常值压力 / 实际移动RH压力 − 1；不是当前帧外缘压力', ...
    'fluxMethod','保存的数值ALE通量 − 上游F−DQ；五分量分别按rhoU、rhoU²、rhoU³归一；强制RH可恒等为零，不能代替压力相容', ...
    'motionMethod','末步输入几何上的请求/共享节点投影法向速度及其差；另列时空平均几何网格速度', ...
    'role','末步通量诊断；采样输入态与几何时间段单列，不冒充当前帧的主体场量');
end

function write(file,value)
fid=fopen(file,'w','n','UTF-8');assert(fid>=0);guard=onCleanup(@()fclose(fid));fprintf(fid,'%s',value);
end
