function report=exportShockFittedKernelStudy(evidenceFile,auditFile,folder)
%EXPORTSHOCKFITTEDKERNELSTUDY 将实际保存的ALE基准与真实鼻部几何检查接回统一科研界面。
% 模块一：读取同一物理文件的独立审计；不在导出时重算流场或补出未知热流。
% 模块二：逐边界面保留邻接单元值、独立壁压、原面号、身份及算法。
% 模块三：只导出实际保存的初末两帧；NASA7仅RH基准，不冒称已作ALE推进。
root=fileparts(fileparts(fileparts(mfilename('fullpath'))));
assert(~exist(folder,'dir'),'ShockFit:Overwrite','视图必须写入新目录。');
d=load(evidenceFile);a=jsondecode(fileread(auditFile));
assert(strcmp(a.status,'passed-independent-moving-RH-direct-xiD-flux-Gauss-GCL-and-real-mesh-audit')&& ...
    strcmp(a.evidenceSHA256,rocketStreamingFileSHA256(evidenceFile))&&~a.productionQualified&& ...
    d.report.completeKernelValidation&&~d.report.productionQualified,'ShockFit:ExportSource','需要同一实际MAT的已完成独立核验。');
methods=struct('pressurePa','邻接有限体积单元压力；常gamma状态方程，由实际保存五量恢复', ...
    'temperatureK','邻接有限体积单元流体温度；不是外缘、恢复或壁面温度', ...
    'speedMS','实际保存三维动量/密度的速度幅值', ...
    'wallPressurePa','移动镜像Riemann求得壁压；仅实际保存的末帧壁面有值', ...
    'heatFluxWm2','未计算黏性热流','wallTemperatureK','未计算壁温，也未设置壁温边界');
p=d.pistons{1};mesh=p.mesh;b=mesh.boundaryFaces;faces=mesh.faces(b,:)-1;owner=mesh.owner(b);
first=struct('position',p.nodes0,'pressurePa',repmat(p.jump.state.pressure,numel(b),1), ...
    'temperatureK',repmat(p.jump.state.temperature,numel(b),1),'speedMS',repmat(norm(p.jump.state.velocity),numel(b),1), ...
    'wallPressurePa',nan(numel(b),1),'heatFluxWm2',nan(numel(b),1),'wallTemperatureK',nan(numel(b),1),'timeS',0);
last=struct('position',p.nodes1,'pressurePa',p.lastStep.state.pressure(owner), ...
    'temperatureK',p.lastStep.state.temperature(owner),'speedMS',vecnorm(p.lastStep.state.velocity(owner,:),2,2), ...
    'wallPressurePa',p.lastStep.wallPressurePa,'heatFluxWm2',nan(numel(b),1),'wallTemperatureK',nan(numel(b),1),'timeS',p.times(end));
cases=cell(2,1);
cases{1}=struct('id','piston','caption','移动活塞 · 内求激波速度基准','faces',faces, ...
    'boundaryKind',p.boundary.kind,'sourceFaceIDs',zeros(numel(b),1),'frames',{{first,last}}, ...
    'methods',methods,'scope','给定活塞速度与均匀上游共同求移动激波；平面解析基准，不是实际箭体外流', ...
    'stateRole','解析活塞初态/实际三维ALE推进末态；云图取边界邻接单元值', ...
    'diagnostic',sprintf('激波相对入射速度%.12g m/s；8次实际ALE步；五量账最大%.3g。', ...
    p.upstreamRelativeShockSpeedMS,max(p.history(:,7))),'productionQualified',false);
s=d.bodyCheck.shell;mesh=s.mesh;b=mesh.boundaryFaces;N=numel(b);kind=ones(N,1);kind(s.wallBoundaryMask)=2;kind(s.outerBoundaryMask)=3;
empty=nan(N,1);frame0=struct('position',s.nodes,'pressurePa',empty,'temperatureK',empty,'speedMS',empty, ...
    'wallPressurePa',empty,'heatFluxWm2',empty,'wallTemperatureK',empty,'timeS',0);
frame1=frame0;frame1.position=d.bodyCheck.nodes1;frame1.timeS=1e-8;
unknown=methods;keys=fieldnames(unknown);for j=1:numel(keys),unknown.(keys{j})='真实箭体物理场未求；几何/GCL数学测试不授予壁面场量';end
cases{2}=struct('id','real-nose','caption','真实20°箭体鼻部 · 几何与GCL检查','faces',mesh.faces(b,:)-1, ...
    'boundaryKind',kind,'sourceFaceIDs',s.cellOriginalFaceIDs(mesh.owner(b)),'frames',{{frame0,frame1}}, ...
    'methods',unknown,'scope','483个原壁面/2898个三维单元；外壳为偏移候选，尚未求出共同激波形状。数学均匀态不绘成真实箭体物理场。', ...
    'stateRole','真实原面号可追溯；压力/各温度/热流全部保持未求', ...
    'diagnostic',sprintf('共享面6337；独立GCL %.3g；声明工作数组预算%.3f MiB（不是进程峰值）。', ...
    a.realMesh.gclRelative,d.report.largestDeclaredArrayBudgetBytes/1024^2),'productionQualified',false);
complete=struct('vertices',double(d.geometry.V),'faces',double(d.geometry.F)-1);
data=struct('kind','shock-fitted-kernel-study-v101','cases',{cases},'originalGeometry',complete, ...
    'source',struct('evidenceFile',strrep(evidenceFile,'\','/'),'evidenceSHA256',a.evidenceSHA256, ...
    'auditFile',strrep(auditFile,'\','/'),'auditSHA256',rocketStreamingFileSHA256(auditFile)), ...
    'NASA7Scope','移动RH及活塞相容已独立核验；未实现NASA7 ALE精确Riemann，故未推进', ...
    'pressureRangePa',[0 40000],'temperatureRangeK',[80 2000], ...
    'productionQualified',false,'newProductionSolvedAreaM2',0,'experimentalValidation',false);
web=fullfile(folder,'workbench');geo=fullfile(web,'geometry');mkdir(geo);
for name={'geometry.js','geometry.css'},copyfile(fullfile(root,'web',name{1}),fullfile(geo,name{1}));end
html=fileread(fullfile(root,'web/geometry.html'));
html=strrep(html,'</body>','<script src="../ale-data.js"></script><script src="ale-study-geometry.js"></script></body>');
write(fullfile(geo,'index.html'),html);copyfile(fullfile(root,'web/ale-study-geometry.js'),fullfile(geo,'ale-study-geometry.js'));
for name={'ale-study.js','ale-study.css','ale-section-core.js'},copyfile(fullfile(root,'web',name{1}),fullfile(web,name{1}));end
copyfile(fullfile(root,'web/ale-study.html'),fullfile(web,'index.html'));
text=jsonencode(data);write(fullfile(web,'ale-data.json'),text);write(fullfile(web,'ale-data.js'),['window.ALE_STUDY=' text ';' newline]);
report=struct('status','exported-saved-piston-and-real-nose-geometry-with-explicit-unsolved-fields', ...
    'cases',2,'frames',4,'productionQualified',false,'newProductionSolvedAreaM2',0, ...
    'dataSHA256',rocketStreamingFileSHA256(fullfile(web,'ale-data.json')));
write(fullfile(folder,'ale_export.json'),jsonencode(report));disp(report);
end
function write(file,value)
fid=fopen(file,'w','n','UTF-8');assert(fid>=0);guard=onCleanup(@()fclose(fid));fprintf(fid,'%s',value);
end
