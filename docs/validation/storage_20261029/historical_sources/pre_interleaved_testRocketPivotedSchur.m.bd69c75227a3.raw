function report=testRocketPivotedSchur(folder)
%TESTROCKETPIVOTEDSCHUR 核对完整标量S、置换方向、五量回代与原字段保持。
% 模块一：零丢弃分解与完整S稠密解核对；非零丢弃只作预条件近似。
% 模块二：强制换行的2阶测试不补对角，完整P*S与L*U关系可独立验证。
% 模块三：实际两排序五量解与稠密分块式一致，预算拒绝且不调用新J/NS。
root=fileparts(fileparts(mfilename('fullpath')));addpath(root,fullfile(root,'internalFlow'));setupCutCellFlow;
assert(~exist(folder,'dir'),'PivotedSchurTest:Overwrite','不得覆盖主元Schur测试。');mkdir(folder);cases=cell(2,1);
parentFile=fullfile(root,'outputs','v83_validation','fieldschurunit01','field_schur_unit_evidence.mat');parent=load(parentFile,'cases');
for j=1:2
    file=fullfile(root,'outputs','v83_validation','schurcheckpointunit01',sprintf('assembly%d',j),'schur_assembly_evidence.mat');a=load(file);m=load(fullfile(fileparts(file),'momentum_factor_evidence.mat'),'M');
    options=struct('dropTolerance',0,'maximumFactorBytes',8*1024^2,'maximumConstructionBytes',64*1024^2);factor=factorRocketPivotedSchur(a.schurMatrix,options);n=factor.cellCount;S=parent.cases{j}.referenceS;
    rhs=parent.cases{j}.rhs(a.algebraicOrder,[1 5]);value=solveRocketPivotedSchur(factor,rhs);direct=S\rhs(:);
    assert(norm(value(:)-direct)/max(1,norm(direct))<1e-8&&norm(S*value(:)-rhs(:))/norm(rhs(:))<1e-8);
    pre=struct('kind','fixed-five-conservation-with-pivoted-scalar-Schur','cellCount',n,'order',a.algebraicOrder, ...
        'rowPointer',m.M.rowPointer,'column',m.M.column,'owners',uint32(repelem((1:n)',diff(double(m.M.rowPointer)))), ...
        'B',a.couplingB,'E',a.couplingE,'momentumFactor',m.M,'schurFactor',factor);
    fullRhs=parent.cases{j}.rhs;full=solveRocketPivotedFieldSchur(pre,fullRhs);c=parent.cases{j};r=fullRhs(a.algebraicOrder,:);
    ym=c.MU\(c.ML\reshape(r(:,2:4),[],1));ys=S\(reshape(r(:,[1 5]),[],1)-c.E*ym);ym=ym-c.MU\(c.ML\(c.B*ys));expected=zeros(n,5);expected(:,2:4)=reshape(ym,n,3);expected(:,[1 5])=reshape(ys,n,2);physical=zeros(n,5);physical(a.algebraicOrder,:)=expected;
    relative=norm(full-physical,'fro')/max(1,norm(physical,'fro'));assert(relative<1e-8);
    other=reshape(cos((1:numel(fullRhs))'*.29),size(fullRhs));v=solveRocketPivotedFieldSchur(pre,other);combined=solveRocketPivotedFieldSchur(pre,.7*fullRhs-1.3*other);
    linearity=norm(combined-.7*full+1.3*v,'fro')/max(1,norm(combined,'fro'));assert(linearity<1e-9);
    approximateOptions=options;approximateOptions.dropTolerance=1e-2;approximate=factorRocketPivotedSchur(a.schurMatrix,approximateOptions);
    cases{j}=struct('pre',pre,'factor',factor,'approximate',approximate,'S',S,'rhs',rhs,'value',value,'fullRhs',fullRhs,'fullValue',full,'fullReference',physical,'fullRelativeDifference',relative,'linearity',linearity);
end
toy=struct('kind','unfactored-conservative-field-block-CSR','dimension',2,'cellCount',1,'rowPointer',uint32([1;2]),'column',uint32(1),'diagonalPosition',uint32(1),'values',[0 1;1 1]);
forced=factorRocketPivotedSchur(toy,options);assert(forced.factorizationReport.permutedRows>0&&~forced.factorizationReport.zeroDiagonalReplacementEnabled);
toyValue=solveRocketPivotedSchur(forced,[2 3]);assert(norm(toy.values*toyValue(:)-[2;3])<1e-12);
bad=options;bad.maximumFactorBytes=1;rejected=false;try,factorRocketPivotedSchur(toy,bad);catch ex,rejected=strcmp(ex.identifier,'PivotedSchur:Budget');end;assert(rejected);
report=struct('status','passed-small-pivoted-Schur-full-S-row-permutation-five-conservation-and-budget-reference', ...
    'forcedRowPivotVerified',true,'diagonalReplacementDisabled',true,'budgetRejected',rejected,'newSelectedJApplications',0,'newActualNSEvaluations',0, ...
    'physicalSolution',false,'newProductionSolvedAreaM2',0,'engineProcessID',feature('getpid'));
save(fullfile(folder,'pivoted_schur_unit_evidence.mat'),'report','parentFile','cases','toy','forced','toyValue','-v7');
fid=fopen(fullfile(folder,'pivoted_schur_unit_summary.json'),'w','n','UTF-8');assert(fid>=0);guard=onCleanup(@()fclose(fid));fprintf(fid,'%s',jsonencode(report));fprintf('%s\n',jsonencode(report));
end
