  "definitions": {
    "cp": "\u5b9a\u538b\u6bd4\u70ed J/(kg K)\uff1b\u539f\u751fIDEAL_GAS\u4e3agamma*R/(gamma-1)\uff0c\u53c2\u8003\u503c\u7531\u65e2\u6709IdealAir DLL\u72ec\u7acb\u8fd4\u56de\u3002",
