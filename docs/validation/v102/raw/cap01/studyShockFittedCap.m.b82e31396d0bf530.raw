function report=studyShockFittedCap(folder,sourceFile,maximumSteps,endTimeS)
%STUDYSHOCKFITTEDCAP 在明确的零攻角经典球鼻上检查真实曲面—共同激波动态候选。
% 模块一：只复用原自由流p/T/rho/R和速度大小，零攻角基准与原20°箭体明确分开。
% 模块二：不读取原箭体已算压力/热流，激波与内部场由三维相容推进。
% 模块三：任何未稳态/出口/热物性问题保留真实结果与检查点，不提升生产资格。
root=fileparts(fileparts(mfilename('fullpath')));addpath(root);setupShockFittedFlow;
assert(~exist(folder,'dir'),'ShockFit:Overwrite','球鼻研究必须使用新目录。');mkdir(folder);
input=load(sourceFile,'fs');fs=input.fs;
up=struct('pressure',double(fs.pressure),'temperature',double(fs.temperature),'density',double(fs.density), ...
    'velocityVector',[-norm(double(fs.flowVelocityVector));0;0], ...
    'method','独立零攻角M5球鼻基准；p/T/rho/R和速率沿用原输入，未使用原箭体场量');
gas=createSurfaceFlowGas('caloricallyPerfect',double(fs.R),1.4);
cap=buildShockFittedSphericalCap(.05,60,4,12,.008,3);
options=struct('maximumSteps',maximumSteps,'endTimeS',endTimeS,'checkpointFile',fullfile(folder,'current_checkpoint.mat'));
study=solveShockFittedCap3D(up,gas,cap,options);
report=struct('status','executed-candidate-three-dimensional-curved-shock-fitted-region', ...
    'sourceAlphaDeg',double(fs.alpha),'benchmarkAlphaDeg',0,'sourceMach',double(fs.Mach), ...
    'acceptedSteps',size(study.history,1),'timeS',study.timeS,'stopReason',study.stopReason, ...
    'candidateDiscreteSteady',study.candidateDiscreteSteady,'bodyVerticesFixed',study.bodyVerticesFixed, ...
    'maximumFacetCentroidSagM',cap.maximumFacetCentroidSagM,'productionQualified',false, ...
    'heatFluxSolved',false,'wallTemperatureSolved',false,'newProductionSolvedAreaM2',0,'engineProcessID',feature('getpid'));
save(fullfile(folder,'curved_cap_evidence.mat'),'study','report','sourceFile','-v7');
fid=fopen(fullfile(folder,'curved_cap_summary.json'),'w','n','UTF-8');assert(fid>=0);guard=onCleanup(@()fclose(fid));fprintf(fid,'%s\n',jsonencode(report));disp(report);
end
