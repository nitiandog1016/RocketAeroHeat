function [flight, freestream, action] = ...
    createFlightCondition(cfg, mesh, host)
%% ========================================================================
% createFlightCondition.m
%
% Rocket AeroHeat
%
% Flight + Freestream Setup GUI
%
% ========================================================================
%
% 功能：
%
%   1. 输入飞行高度
%
%   2. 输入 Mach 数
%
%   3. 输入攻角 alpha
%
%   4. 输入侧滑角 beta
%
%   5. 输入壁面温度 Twall
%
%   6. 自动调用 standardAtmosphere
%
%   7. 自动调用 calcFreestream
%
%   8. 三维显示：
%
%           箭体
%
%           +X Body Axis
%
%           Vehicle Direction
%
%           Relative Air Flow Direction
%
%   9. 实时预览：
%
%           Windward
%
%           Leeward
%
%           mu = -n dot Vflow
%
%  10. 用户确认后返回：
%
%           flight
%
%           freestream
%
%           action
%
%
% ========================================================================
%
% 调用：
%
% [flight,freestream,action] = ...
%     createFlightCondition(cfg,mesh);
%
%
% action：
%
%       'continue'
%
%       'cancel'
%
%% ========================================================================



%% ========================================================================
% 1. 输入兼容
% ========================================================================

if nargin < 1 || isempty(cfg)

    cfg = struct;

end


if nargin < 2

    mesh = [];

end



%% ========================================================================
% 2. 默认飞行参数
% ========================================================================

defaultAltitude = ...
    getCfgValue( ...
        cfg, ...
        {'flight','altitude'}, ...
        30000);


defaultMach = ...
    getCfgValue( ...
        cfg, ...
        {'flight','Mach'}, ...
        5.0);


defaultAlpha = ...
    getCfgValue( ...
        cfg, ...
        {'flight','alpha'}, ...
        0.0);


defaultBeta = ...
    getCfgValue( ...
        cfg, ...
        {'flight','beta'}, ...
        0.0);


defaultTwall = ...
    getCfgValue( ...
        cfg, ...
        {'flight','Twall'}, ...
        300.0);



%% ========================================================================
% 3. GUI 滑块范围
% ========================================================================

alphaRange = ...
    getCfgValue( ...
        cfg, ...
        {'gui','alphaSliderRange_deg'}, ...
        [-30 30]);


betaRange = ...
    getCfgValue( ...
        cfg, ...
        {'gui','betaSliderRange_deg'}, ...
        [-30 30]);



%% ========================================================================
% 4. 初始化返回值
% ========================================================================

flight = struct;

freestream = struct;

action = ...
    'cancel';



%% ========================================================================
% 5. 当前 GUI 计算状态
% ========================================================================

currentFlight = struct;

currentFreestream = struct;

currentMu = [];



%% ========================================================================
% 6. 创建窗口
% ========================================================================

% 可选宿主面板：飞行参数与前处理共用同一个窗口。
embedded = nargin >= 3 && ~isempty(host) && isgraphics(host);
if embedded
    fig = ancestor(host,'figure');
    hideAeroHeatPages(host);
    parent = host;
else
fig = ...
    uifigure( ...
        'Name', ...
        'Rocket AeroHeat - Flight & Freestream Setup', ...
        'Position', ...
        [40 40 1550 880], ...
        'Color', ...
        [0.97 0.97 0.97]);


    parent = fig;
end

if embedded
    fig.CloseRequestFcn = @(src,event)delete(src);
else
    fig.CloseRequestFcn = @cancelCallback;
end



%% ========================================================================
% 7. 主布局
% ========================================================================

mainGrid = ...
    uigridlayout( ...
        parent, ...
        [2 3]);


mainGrid.RowHeight = ...
    {'1x',55};


mainGrid.ColumnWidth = ...
    {335,'1x',355};


mainGrid.Padding = ...
    [8 8 8 8];


mainGrid.RowSpacing = ...
    8;


mainGrid.ColumnSpacing = ...
    8;



%% ========================================================================
% 8. 左侧输入面板
% ========================================================================

inputPanel = ...
    uipanel( ...
        mainGrid, ...
        'Title', ...
        'Flight Condition Input', ...
        'FontWeight', ...
        'bold');


inputPanel.Layout.Row = 1;

inputPanel.Layout.Column = 1;


inputGrid = ...
    uigridlayout( ...
        inputPanel, ...
        [17 2]);


inputGrid.ColumnWidth = ...
    {'1x',110};


inputGrid.RowHeight = { ...
    38, ...
    30, ...
    30, ...
    30, ...
    40, ...
    30, ...
    40, ...
    30, ...
    30, ...
    32, ...
    28, ...
    28, ...
    28, ...
    28, ...
    '1x', ...
    32, ...
    30};


inputGrid.Padding = ...
    [10 10 10 10];


inputGrid.RowSpacing = ...
    6;



%% ========================================================================
% 9. 标题
% ========================================================================

titleLabel = ...
    uilabel( ...
        inputGrid, ...
        'Text', ...
        '飞行条件与来流方向', ...
        'FontWeight', ...
        'bold', ...
        'FontSize', ...
        17, ...
        'HorizontalAlignment', ...
        'center');


titleLabel.Layout.Row = 1;

titleLabel.Layout.Column = [1 2];



%% ========================================================================
% 10. 高度
% ========================================================================

altitudeLabel = ...
    uilabel( ...
        inputGrid, ...
        'Text', ...
        '几何海拔高度 H / km');


altitudeLabel.Layout.Row = 2;

altitudeLabel.Layout.Column = 1;


altitudeField = ...
    uieditfield( ...
        inputGrid, ...
        'numeric', ...
        'Limits', ...
        [0 86], ...
        'ValueDisplayFormat', ...
        '%.3f', ...
        'Value', ...
        defaultAltitude/1000);


altitudeField.Layout.Row = 2;

altitudeField.Layout.Column = 2;



%% ========================================================================
% 11. Mach
% ========================================================================

machLabel = ...
    uilabel( ...
        inputGrid, ...
        'Text', ...
        'Mach 数 M∞');


machLabel.Layout.Row = 3;

machLabel.Layout.Column = 1;


machField = ...
    uieditfield( ...
        inputGrid, ...
        'numeric', ...
        'Limits', ...
        [0 30], ...
        'ValueDisplayFormat', ...
        '%.4f', ...
        'Value', ...
        defaultMach);


machField.Layout.Row = 3;

machField.Layout.Column = 2;



%% ========================================================================
% 12. Alpha 数值
% ========================================================================

alphaLabel = ...
    uilabel( ...
        inputGrid, ...
        'Text', ...
        '攻角 alpha / deg');


alphaLabel.Layout.Row = 4;

alphaLabel.Layout.Column = 1;


alphaField = ...
    uieditfield( ...
        inputGrid, ...
        'numeric', ...
        'Limits', ...
        [-90 90], ...
        'ValueDisplayFormat', ...
        '%.3f', ...
        'Value', ...
        defaultAlpha);


alphaField.Layout.Row = 4;

alphaField.Layout.Column = 2;



%% ========================================================================
% 13. Alpha 滑块
% ========================================================================

alphaSlider = ...
    uislider( ...
        inputGrid, ...
        'Limits', ...
        alphaRange, ...
        'Value', ...
        clampValue( ...
            defaultAlpha, ...
            alphaRange));


alphaSlider.Layout.Row = 5;

alphaSlider.Layout.Column = [1 2];



%% ========================================================================
% 14. Beta 数值
% ========================================================================

betaLabel = ...
    uilabel( ...
        inputGrid, ...
        'Text', ...
        '侧滑角 beta / deg');


betaLabel.Layout.Row = 6;

betaLabel.Layout.Column = 1;


betaField = ...
    uieditfield( ...
        inputGrid, ...
        'numeric', ...
        'Limits', ...
        [-90 90], ...
        'ValueDisplayFormat', ...
        '%.3f', ...
        'Value', ...
        defaultBeta);


betaField.Layout.Row = 6;

betaField.Layout.Column = 2;



%% ========================================================================
% 15. Beta 滑块
% ========================================================================

betaSlider = ...
    uislider( ...
        inputGrid, ...
        'Limits', ...
        betaRange, ...
        'Value', ...
        clampValue( ...
            defaultBeta, ...
            betaRange));


betaSlider.Layout.Row = 7;

betaSlider.Layout.Column = [1 2];



%% ========================================================================
% 16. 壁温
% ========================================================================

wallTemperatureLabel = ...
    uilabel( ...
        inputGrid, ...
        'Text', ...
        '壁面温度 Tw / K');


wallTemperatureLabel.Layout.Row = 8;

wallTemperatureLabel.Layout.Column = 1;


wallTemperatureField = ...
    uieditfield( ...
        inputGrid, ...
        'numeric', ...
        'Limits', ...
        [50 5000], ...
        'ValueDisplayFormat', ...
        '%.2f', ...
        'Value', ...
        defaultTwall);


wallTemperatureField.Layout.Row = 8;

wallTemperatureField.Layout.Column = 2;



%% ========================================================================
% 17. 显示模式
% ========================================================================

displayModeLabel = ...
    uilabel( ...
        inputGrid, ...
        'Text', ...
        '表面显示模式');


displayModeLabel.Layout.Row = 9;

displayModeLabel.Layout.Column = 1;


displayMode = ...
    uidropdown( ...
        inputGrid, ...
        'Items', ...
        { ...
        'Windward / Leeward', ...
        'Incidence mu', ...
        'Plain Geometry'}, ...
        'Value', ...
        'Windward / Leeward');


displayMode.Layout.Row = 9;

displayMode.Layout.Column = 2;



%% ========================================================================
% 18. 显示开关
% ========================================================================

displayOptionGrid = ...
    uigridlayout( ...
        inputGrid, ...
        [1 2]);


displayOptionGrid.Layout.Row = 10;

displayOptionGrid.Layout.Column = [1 2];


displayOptionGrid.ColumnWidth = ...
    {'1x','1x'};


displayOptionGrid.Padding = ...
    [0 0 0 0];


showEdgesCheck = ...
    uicheckbox( ...
        displayOptionGrid, ...
        'Text', ...
        '显示网格', ...
        'Value', ...
        true);


showArrowCheck = ...
    uicheckbox( ...
        displayOptionGrid, ...
        'Text', ...
        '显示方向箭头', ...
        'Value', ...
        true);



%% ========================================================================
% 19. 坐标说明
% ========================================================================

coordinateTitle = ...
    uilabel( ...
        inputGrid, ...
        'Text', ...
        '坐标与符号约定', ...
        'FontWeight', ...
        'bold');


coordinateTitle.Layout.Row = 11;

coordinateTitle.Layout.Column = [1 2];


coordinate1 = ...
    uilabel( ...
        inputGrid, ...
        'Text', ...
        '+X：箭体前向 / 鼻头方向');


coordinate1.Layout.Row = 12;

coordinate1.Layout.Column = [1 2];


coordinate2 = ...
    uilabel( ...
        inputGrid, ...
        'Text', ...
        '+alpha：来流向 +Z 偏转');


coordinate2.Layout.Row = 13;

coordinate2.Layout.Column = [1 2];


coordinate3 = ...
    uilabel( ...
        inputGrid, ...
        'Text', ...
        '+beta：来流向 -Y 偏转');


coordinate3.Layout.Row = 14;

coordinate3.Layout.Column = [1 2];



%% ========================================================================
% 20. 恢复默认
% ========================================================================

resetButton = ...
    uibutton( ...
        inputGrid, ...
        'push', ...
        'Text', ...
        '恢复默认飞行条件');


resetButton.Layout.Row = 16;

resetButton.Layout.Column = [1 2];


statusLabel = ...
    uilabel( ...
        inputGrid, ...
        'Text', ...
        'Ready', ...
        'HorizontalAlignment', ...
        'center');


statusLabel.Layout.Row = 17;

statusLabel.Layout.Column = [1 2];



%% ========================================================================
% 21. 中间三维可视化面板
% ========================================================================

viewPanel = ...
    uipanel( ...
        mainGrid, ...
        'Title', ...
        '3-D Freestream Preview', ...
        'FontWeight', ...
        'bold');


viewPanel.Layout.Row = 1;

viewPanel.Layout.Column = 2;


viewGrid = ...
    uigridlayout( ...
        viewPanel, ...
        [2 1]);


viewGrid.RowHeight = ...
    {'1x',42};


viewGrid.Padding = ...
    [3 3 3 3];



%% ========================================================================
% 22. 三维坐标轴
% ========================================================================

ax = ...
    uiaxes(viewGrid);


ax.Layout.Row = 1;

ax.Layout.Column = 1;


xlabel(ax,'X / m');

ylabel(ax,'Y / m');

zlabel(ax,'Z / m');


grid(ax,'on');

box(ax,'on');


axis(ax,'equal');

axis(ax,'vis3d');


try

    ax.Clipping = ...
        'off';

catch
end


try

    camproj( ...
        ax, ...
        'orthographic');

catch
end


try

    ax.Interactions = ...
        [ ...
        rotateInteraction, ...
        panInteraction, ...
        zoomInteraction ...
        ];

catch
end


try

    axtoolbar( ...
        ax, ...
        {'rotate','pan','zoomin','zoomout','restoreview'});

catch
end



%% ========================================================================
% 23. 快捷视图按钮
% ========================================================================

viewButtonGrid = ...
    uigridlayout( ...
        viewGrid, ...
        [1 3]);


viewButtonGrid.Layout.Row = 2;

viewButtonGrid.Layout.Column = 1;


viewButtonGrid.ColumnWidth = ...
    {'1x','1x','1x'};


viewButtonGrid.Padding = ...
    [0 0 0 0];


view3DButton = ...
    uibutton( ...
        viewButtonGrid, ...
        'push', ...
        'Text', ...
        '3D');


sideViewButton = ...
    uibutton( ...
        viewButtonGrid, ...
        'push', ...
        'Text', ...
        'X-Z Side');


topViewButton = ...
    uibutton( ...
        viewButtonGrid, ...
        'push', ...
        'Text', ...
        'X-Y Top');



%% ========================================================================
% 24. 右侧结果面板
% ========================================================================

resultPanel = ...
    uipanel( ...
        mainGrid, ...
        'Title', ...
        'Atmosphere & Freestream', ...
        'FontWeight', ...
        'bold', ...
        'Scrollable', ...
        'on');


resultPanel.Layout.Row = 1;

resultPanel.Layout.Column = 3;


resultGrid = ...
    uigridlayout( ...
        resultPanel, ...
        [15 2]);


resultGrid.ColumnWidth = ...
    {'1.15x','1x'};


resultGrid.RowHeight = ...
    repmat({31},1,15);


resultGrid.Padding = ...
    [10 10 10 10];



%% ========================================================================
% 25. 结果字段
% ========================================================================

temperatureValue = ...
    addResultRow( ...
        resultGrid, ...
        1, ...
        'T infinity');


pressureValue = ...
    addResultRow( ...
        resultGrid, ...
        2, ...
        'p infinity');


densityValue = ...
    addResultRow( ...
        resultGrid, ...
        3, ...
        'rho infinity');


soundValue = ...
    addResultRow( ...
        resultGrid, ...
        4, ...
        'Speed of sound');


viscosityValue = ...
    addResultRow( ...
        resultGrid, ...
        5, ...
        'Dynamic viscosity');


velocityValue = ...
    addResultRow( ...
        resultGrid, ...
        6, ...
        'V infinity');


dynamicPressureValue = ...
    addResultRow( ...
        resultGrid, ...
        7, ...
        'q infinity');


reynoldsValue = ...
    addResultRow( ...
        resultGrid, ...
        8, ...
        'Re / m');


totalTemperatureValue = ...
    addResultRow( ...
        resultGrid, ...
        9, ...
        'Total temperature');


flightDirectionValue = ...
    addResultRow( ...
        resultGrid, ...
        10, ...
        'Vehicle direction');


flowDirectionValue = ...
    addResultRow( ...
        resultGrid, ...
        11, ...
        'Air flow direction');


windwardFaceValue = ...
    addResultRow( ...
        resultGrid, ...
        12, ...
        'Windward faces');


windwardAreaValue = ...
    addResultRow( ...
        resultGrid, ...
        13, ...
        'Windward area');


muMaxValue = ...
    addResultRow( ...
        resultGrid, ...
        14, ...
        'Maximum mu');


geopotentialValue = ...
    addResultRow( ...
        resultGrid, ...
        15, ...
        'Geopotential H');



%% ========================================================================
% 26. 底部按钮
% ========================================================================

bottomGrid = ...
    uigridlayout( ...
        mainGrid, ...
        [1 2]);


bottomGrid.Layout.Row = 2;

bottomGrid.Layout.Column = [1 3];


bottomGrid.ColumnWidth = ...
    {'1.5x','1x'};


bottomGrid.Padding = ...
    [0 0 0 0];


confirmButton = ...
    uibutton( ...
        bottomGrid, ...
        'push', ...
        'Text', ...
        '确认飞行条件并继续', ...
        'FontWeight', ...
        'bold', ...
        'FontSize', ...
        14);


cancelButton = ...
    uibutton( ...
        bottomGrid, ...
        'push', ...
        'Text', ...
        '取消主程序');



%% ========================================================================
% 27. 回调函数
% ========================================================================

altitudeField.ValueChangedFcn = ...
    @(~,~)updateEverything(false);


machField.ValueChangedFcn = ...
    @(~,~)updateEverything(false);


alphaField.ValueChangedFcn = ...
    @alphaFieldChanged;


betaField.ValueChangedFcn = ...
    @betaFieldChanged;


wallTemperatureField.ValueChangedFcn = ...
    @(~,~)updateEverything(false);


alphaSlider.ValueChangingFcn = ...
    @alphaSliderChanging;


alphaSlider.ValueChangedFcn = ...
    @alphaSliderChanged;


betaSlider.ValueChangingFcn = ...
    @betaSliderChanging;


betaSlider.ValueChangedFcn = ...
    @betaSliderChanged;


displayMode.ValueChangedFcn = ...
    @(~,~)renderScene(false);


showEdgesCheck.ValueChangedFcn = ...
    @(~,~)renderScene(false);


showArrowCheck.ValueChangedFcn = ...
    @(~,~)renderScene(false);


resetButton.ButtonPushedFcn = ...
    @resetCallback;


confirmButton.ButtonPushedFcn = ...
    @confirmCallback;


cancelButton.ButtonPushedFcn = ...
    @cancelCallback;


view3DButton.ButtonPushedFcn = ...
    @(~,~)set3DView();


sideViewButton.ButtonPushedFcn = ...
    @(~,~)setSideView();


topViewButton.ButtonPushedFcn = ...
    @(~,~)setTopView();



%% ========================================================================
% 28. 初次计算
% ========================================================================

updateEverything(true);



%% ========================================================================
% 29. 阻塞 main
% ========================================================================

uiwait(fig);



%% ========================================================================
% 30. GUI 返回后关闭
% ========================================================================

if isvalid(fig) && ~embedded
    delete(fig);
end



%% ========================================================================
% NESTED FUNCTION
% 构造当前 flight
%% ========================================================================

    function [flightNow,freestreamNow] = ...
            calculateCurrentCondition()

        altitude = ...
            altitudeField.Value ...
            * ...
            1000;


        atmosphere = ...
            standardAtmosphere( ...
                altitude);


        flightNow = struct;


        flightNow.altitude = ...
            altitude;


        flightNow.Mach = ...
            machField.Value;


        flightNow.alpha = ...
            alphaField.Value;


        flightNow.beta = ...
            betaField.Value;


        flightNow.Twall = ...
            wallTemperatureField.Value;


        flightNow.alphaRad = ...
            deg2rad( ...
                flightNow.alpha);


        flightNow.betaRad = ...
            deg2rad( ...
                flightNow.beta);


        flightNow.atmosphere = ...
            atmosphere;


        freestreamNow = ...
            calcFreestream( ...
                flightNow);


        flightNow.Vinf = ...
            freestreamNow.speed;


        flightNow.qinf = ...
            freestreamNow.dynamicPressure;

    end



%% ========================================================================
% NESTED FUNCTION
% 更新全部状态
%% ========================================================================

    function updateEverything(resetView)

        try

            [currentFlight, ...
             currentFreestream] = ...
                calculateCurrentCondition();


            %% -----------------------------------------------------------
            % 面元迎风参数
            %% -----------------------------------------------------------

            if ~isempty(mesh) ...
                    && ...
                    isfield(mesh,'normal')


                currentMu = ...
                    -mesh.normal ...
                    * ...
                    currentFreestream.unitFlowDirection';


            else

                currentMu = [];

            end


            updateResultPanel();


            renderScene(resetView);


            statusLabel.Text = ...
                'Freestream calculation OK';


        catch ME

            statusLabel.Text = ...
                ['ERROR: ',ME.message];

        end

    end



%% ========================================================================
% NESTED FUNCTION
% 更新右侧数值
%% ========================================================================

    function updateResultPanel()

        atm = ...
            currentFlight.atmosphere;


        temperatureValue.Text = ...
            sprintf( ...
                '%.3f K', ...
                atm.temperature);


        pressureValue.Text = ...
            sprintf( ...
                '%.6e Pa', ...
                atm.pressure);


        densityValue.Text = ...
            sprintf( ...
                '%.6e kg/m^3', ...
                atm.density);


        soundValue.Text = ...
            sprintf( ...
                '%.3f m/s', ...
                atm.speedOfSound);


        viscosityValue.Text = ...
            sprintf( ...
                '%.6e Pa*s', ...
                atm.dynamicViscosity);


        velocityValue.Text = ...
            sprintf( ...
                '%.3f m/s', ...
                currentFreestream.speed);


        dynamicPressureValue.Text = ...
            sprintf( ...
                '%.6e Pa', ...
                currentFreestream.dynamicPressure);


        reynoldsValue.Text = ...
            sprintf( ...
                '%.6e 1/m', ...
                currentFreestream.reynoldsPerMeter);


        totalTemperatureValue.Text = ...
            sprintf( ...
                '%.3f K', ...
                currentFreestream.totalTemperature);


        flightDirectionValue.Text = ...
            vectorToString( ...
                currentFreestream.unitFlightDirection);


        flowDirectionValue.Text = ...
            vectorToString( ...
                currentFreestream.unitFlowDirection);


        geopotentialValue.Text = ...
            sprintf( ...
                '%.3f km', ...
                atm.geopotentialAltitude/1000);


        %% ---------------------------------------------------------------
        % 面元迎风统计
        %% ---------------------------------------------------------------

        if isempty(currentMu)

            windwardFaceValue.Text = '--';

            windwardAreaValue.Text = '--';

            muMaxValue.Text = '--';


        else

            tolerance = ...
                1e-10;


            windward = ...
                currentMu > tolerance;


            numberWindward = ...
                sum(windward);


            numberTotal = ...
                numel(currentMu);


            windwardFaceValue.Text = ...
                sprintf( ...
                    '%d / %d', ...
                    numberWindward, ...
                    numberTotal);


            if isfield(mesh,'area') ...
                    && ...
                    numel(mesh.area) == numberTotal


                totalArea = ...
                    sum(mesh.area);


                windwardArea = ...
                    sum( ...
                        mesh.area(windward));


                areaPercent = ...
                    100 ...
                    * ...
                    windwardArea ...
                    / ...
                    max(totalArea,eps);


                windwardAreaValue.Text = ...
                    sprintf( ...
                        '%.2f %%', ...
                        areaPercent);


            else

                windwardAreaValue.Text = '--';

            end


            muMaxValue.Text = ...
                sprintf( ...
                    '%.6f', ...
                    max(currentMu));

        end

    end



%% ========================================================================
% NESTED FUNCTION
% 三维绘图
%% ========================================================================

    function renderScene(resetView)

        if isempty(currentFreestream)
            return;
        end


        %% ---------------------------------------------------------------
        % 保存相机
        %% ---------------------------------------------------------------

        oldCameraPosition = ...
            ax.CameraPosition;


        oldCameraTarget = ...
            ax.CameraTarget;


        oldCameraUpVector = ...
            ax.CameraUpVector;


        oldCameraViewAngle = ...
            ax.CameraViewAngle;


        %% ---------------------------------------------------------------
        % 清图
        %% ---------------------------------------------------------------

        cla(ax);


        try

            colorbar(ax,'off');

        catch
        end


        hold(ax,'on');


        %% ---------------------------------------------------------------
        % 如果没有 mesh，仅画方向示意
        %% ---------------------------------------------------------------

        if isempty(mesh) || ...
                ~isfield(mesh,'V') || ...
                isempty(mesh.V)


            modelCenter = ...
                [0 0 0];


            modelLength = ...
                1;


            xmin = -0.5;

            xmax = 0.5;

            ymin = -0.5;

            ymax = 0.5;

            zmin = -0.5;

            zmax = 0.5;


        else

            V = ...
                mesh.V;


            xmin = min(V(:,1));

            xmax = max(V(:,1));

            ymin = min(V(:,2));

            ymax = max(V(:,2));

            zmin = min(V(:,3));

            zmax = max(V(:,3));


            modelCenter = [ ...
                0.5*(xmin+xmax), ...
                0.5*(ymin+ymax), ...
                0.5*(zmin+zmax)];


            modelLength = ...
                max( ...
                [ ...
                xmax-xmin, ...
                ymax-ymin, ...
                zmax-zmin ...
                ]);


            if modelLength <= 0

                modelLength = 1;

            end


            %% ===========================================================
            % 网格边颜色
            %% ===========================================================

            if showEdgesCheck.Value

                edgeColor = ...
                    [0.30 0.30 0.30];

            else

                edgeColor = ...
                    'none';

            end


            %% ===========================================================
            % 表面显示
            %% ===========================================================

            switch displayMode.Value


                %% -------------------------------------------------------
                % Windward / Leeward
                %% -------------------------------------------------------

                case 'Windward / Leeward'

                    if isempty(currentMu)

                        patch( ...
                            ax, ...
                            'Faces', mesh.F, ...
                            'Vertices', mesh.V, ...
                            'FaceColor', [0.72 0.75 0.78], ...
                            'EdgeColor', edgeColor);


                    else

                        tangentTolerance = ...
                            1e-6;


                        windward = ...
                            currentMu > tangentTolerance;


                        leeward = ...
                            currentMu < -tangentTolerance;


                        tangent = ...
                            ~(windward | leeward);


                        if any(windward)

                            patch( ...
                                ax, ...
                                'Faces', ...
                                mesh.F(windward,:), ...
                                'Vertices', ...
                                mesh.V, ...
                                'FaceColor', ...
                                [0.86 0.43 0.32], ...
                                'EdgeColor', ...
                                edgeColor, ...
                                'FaceAlpha', ...
                                0.95);

                        end


                        if any(leeward)

                            patch( ...
                                ax, ...
                                'Faces', ...
                                mesh.F(leeward,:), ...
                                'Vertices', ...
                                mesh.V, ...
                                'FaceColor', ...
                                [0.32 0.51 0.78], ...
                                'EdgeColor', ...
                                edgeColor, ...
                                'FaceAlpha', ...
                                0.95);

                        end


                        if any(tangent)

                            patch( ...
                                ax, ...
                                'Faces', ...
                                mesh.F(tangent,:), ...
                                'Vertices', ...
                                mesh.V, ...
                                'FaceColor', ...
                                [0.68 0.68 0.68], ...
                                'EdgeColor', ...
                                edgeColor);

                        end

                    end


                    title( ...
                        ax, ...
                        sprintf( ...
                        'Windward / Leeward Preview   alpha = %.2f deg   beta = %.2f deg', ...
                        currentFlight.alpha, ...
                        currentFlight.beta));


                %% -------------------------------------------------------
                % mu 云图
                %% -------------------------------------------------------

                case 'Incidence mu'

                    if isempty(currentMu)

                        patch( ...
                            ax, ...
                            'Faces', ...
                            mesh.F, ...
                            'Vertices', ...
                            mesh.V, ...
                            'FaceColor', ...
                            [0.72 0.75 0.78], ...
                            'EdgeColor', ...
                            edgeColor);


                    else

                        patch( ...
                            ax, ...
                            'Faces', ...
                            mesh.F, ...
                            'Vertices', ...
                            mesh.V, ...
                            'FaceVertexCData', ...
                            currentMu, ...
                            'FaceColor', ...
                            'flat', ...
                            'EdgeColor', ...
                            edgeColor);


                        cb = ...
                            colorbar(ax);


                        cb.Label.String = ...
                            'mu = -n dot Vflow';


                        caxis( ...
                            ax, ...
                            [-1 1]);


                        colormap( ...
                            ax, ...
                            parula(256));

                    end


                    title( ...
                        ax, ...
                        'Local Incidence Parameter');


                %% -------------------------------------------------------
                % 普通几何
                %% -------------------------------------------------------

                case 'Plain Geometry'

                    patch( ...
                        ax, ...
                        'Faces', ...
                        mesh.F, ...
                        'Vertices', ...
                        mesh.V, ...
                        'FaceColor', ...
                        [0.72 0.75 0.78], ...
                        'EdgeColor', ...
                        edgeColor);


                    title( ...
                        ax, ...
                        'Freestream Geometry Preview');

            end

        end



        %% =================================================================
        % 方向箭头
        %% =================================================================

        if showArrowCheck.Value


            %% ------------------------------------------------------------
            % +X Body Axis
            %% ------------------------------------------------------------

            bodyAxisLength = ...
                0.38 ...
                * ...
                modelLength;


            quiver3( ...
                ax, ...
                modelCenter(1), ...
                modelCenter(2), ...
                modelCenter(3), ...
                bodyAxisLength, ...
                0, ...
                0, ...
                0, ...
                'Color', ...
                [0.80 0.10 0.10], ...
                'LineWidth', ...
                2.0, ...
                'MaxHeadSize', ...
                0.5);


            bodyAxisEnd = ...
                modelCenter ...
                + ...
                [bodyAxisLength 0 0];


            text( ...
                ax, ...
                bodyAxisEnd(1), ...
                bodyAxisEnd(2), ...
                bodyAxisEnd(3), ...
                '  Body +X', ...
                'FontWeight', ...
                'bold');


            %% ------------------------------------------------------------
            % Vehicle Direction
            %% ------------------------------------------------------------

            flightArrowLength = ...
                0.48 ...
                * ...
                modelLength;


            vehicleVector = ...
                flightArrowLength ...
                * ...
                currentFreestream.unitFlightDirection;


            quiver3( ...
                ax, ...
                modelCenter(1), ...
                modelCenter(2), ...
                modelCenter(3), ...
                vehicleVector(1), ...
                vehicleVector(2), ...
                vehicleVector(3), ...
                0, ...
                'Color', ...
                [0.15 0.60 0.20], ...
                'LineWidth', ...
                2.4, ...
                'MaxHeadSize', ...
                0.5);


            vehicleEnd = ...
                modelCenter ...
                + ...
                vehicleVector;


            text( ...
                ax, ...
                vehicleEnd(1), ...
                vehicleEnd(2), ...
                vehicleEnd(3), ...
                '  Vehicle', ...
                'FontWeight', ...
                'bold');


            %% ------------------------------------------------------------
            % Air Flow Direction
            %
            % 箭头从上游位置指向箭体。
            %% ------------------------------------------------------------

            flowDirection = ...
                currentFreestream.unitFlowDirection;


            upstreamPoint = ...
                modelCenter ...
                - ...
                0.78 ...
                * ...
                modelLength ...
                * ...
                flowDirection;


            flowArrowVector = ...
                0.28 ...
                * ...
                modelLength ...
                * ...
                flowDirection;


            quiver3( ...
                ax, ...
                upstreamPoint(1), ...
                upstreamPoint(2), ...
                upstreamPoint(3), ...
                flowArrowVector(1), ...
                flowArrowVector(2), ...
                flowArrowVector(3), ...
                0, ...
                'Color', ...
                [0.10 0.35 0.90], ...
                'LineWidth', ...
                3.0, ...
                'MaxHeadSize', ...
                0.6);


            text( ...
                ax, ...
                upstreamPoint(1), ...
                upstreamPoint(2), ...
                upstreamPoint(3), ...
                '  Air Flow Vinf', ...
                'FontWeight', ...
                'bold');

        end



        %% =================================================================
        % 坐标轴范围
        %% =================================================================

        margin = ...
            0.35 ...
            * ...
            modelLength;


        xlim( ...
            ax, ...
            [xmin-margin, ...
             xmax+margin]);


        ylim( ...
            ax, ...
            [ymin-margin, ...
             ymax+margin]);


        zlim( ...
            ax, ...
            [zmin-margin, ...
             zmax+margin]);


        axis(ax,'equal');

        axis(ax,'vis3d');


        grid(ax,'on');

        box(ax,'on');


        xlabel(ax,'X / m');

        ylabel(ax,'Y / m');

        zlabel(ax,'Z / m');


        try

            ax.Clipping = ...
                'off';

        catch
        end


        try

            camproj( ...
                ax, ...
                'orthographic');

        catch
        end


        %% =================================================================
        % 视角
        %% =================================================================

        if resetView

            view( ...
                ax, ...
                35, ...
                25);


            camtarget( ...
                ax, ...
                modelCenter);


        else

            try

                ax.CameraPosition = ...
                    oldCameraPosition;


                ax.CameraTarget = ...
                    oldCameraTarget;


                ax.CameraUpVector = ...
                    oldCameraUpVector;


                ax.CameraViewAngle = ...
                    oldCameraViewAngle;

            catch
            end

        end


        hold(ax,'off');


        drawnow limitrate;

    end



%% ========================================================================
% Alpha 数值框
%% ========================================================================

    function alphaFieldChanged(~,~)

        alphaSlider.Value = ...
            clampValue( ...
                alphaField.Value, ...
                alphaSlider.Limits);


        updateEverything(false);

    end



%% ========================================================================
% Alpha Slider 移动
%% ========================================================================

    function alphaSliderChanging(~,event)

        alphaField.Value = ...
            event.Value;


        updateEverything(false);

    end



%% ========================================================================
% Alpha Slider 松开
%% ========================================================================

    function alphaSliderChanged(src,~)

        alphaField.Value = ...
            src.Value;


        updateEverything(false);

    end



%% ========================================================================
% Beta 数值框
%% ========================================================================

    function betaFieldChanged(~,~)

        betaSlider.Value = ...
            clampValue( ...
                betaField.Value, ...
                betaSlider.Limits);


        updateEverything(false);

    end



%% ========================================================================
% Beta Slider 移动
%% ========================================================================

    function betaSliderChanging(~,event)

        betaField.Value = ...
            event.Value;


        updateEverything(false);

    end



%% ========================================================================
% Beta Slider 松开
%% ========================================================================

    function betaSliderChanged(src,~)

        betaField.Value = ...
            src.Value;


        updateEverything(false);

    end



%% ========================================================================
% 恢复默认值
%% ========================================================================

    function resetCallback(~,~)

        altitudeField.Value = ...
            defaultAltitude/1000;


        machField.Value = ...
            defaultMach;


        alphaField.Value = ...
            defaultAlpha;


        betaField.Value = ...
            defaultBeta;


        wallTemperatureField.Value = ...
            defaultTwall;


        alphaSlider.Value = ...
            clampValue( ...
                defaultAlpha, ...
                alphaSlider.Limits);


        betaSlider.Value = ...
            clampValue( ...
                defaultBeta, ...
                betaSlider.Limits);


        updateEverything(true);

    end



%% ========================================================================
% 确认
%% ========================================================================

    function confirmCallback(~,~)

        try

            [flight,freestream] = ...
                calculateCurrentCondition();


            action = ...
                'continue';


            assignin( ...
                'base', ...
                'flight', ...
                flight);


            assignin( ...
                'base', ...
                'freestream', ...
                freestream);


            assignin( ...
                'base', ...
                'atmosphere', ...
                flight.atmosphere);


            uiresume(fig);


        catch ME

            uialert( ...
                fig, ...
                ME.message, ...
                '飞行条件错误', ...
                'Icon', ...
                'error');

        end

    end



%% ========================================================================
% 取消
%% ========================================================================

    function cancelCallback(~,~)

        action = ...
            'cancel';


        uiresume(fig);

    end



%% ========================================================================
% 3D 视图
%% ========================================================================

    function set3DView()

        view( ...
            ax, ...
            35, ...
            25);

    end



%% ========================================================================
% X-Z 侧视图
%% ========================================================================

    function setSideView()

        view( ...
            ax, ...
            [0 -1 0]);

    end



%% ========================================================================
% X-Y 顶视图
%% ========================================================================

    function setTopView()

        view( ...
            ax, ...
            [0 0 1]);

    end

end



%% ========================================================================
% LOCAL FUNCTION
% 右侧结果行
%% ========================================================================
function valueLabel = ...
    addResultRow(grid,row,name)

nameLabel = ...
    uilabel( ...
        grid, ...
        'Text', ...
        name);


nameLabel.Layout.Row = ...
    row;


nameLabel.Layout.Column = ...
    1;


valueLabel = ...
    uilabel( ...
        grid, ...
        'Text', ...
        '--');


valueLabel.Layout.Row = ...
    row;


valueLabel.Layout.Column = ...
    2;

end



%% ========================================================================
% LOCAL FUNCTION
% 向量转换为字符串
%% ========================================================================
function str = ...
    vectorToString(v)

str = ...
    sprintf( ...
        '[%.4f  %.4f  %.4f]', ...
        v(1), ...
        v(2), ...
        v(3));

end



%% ========================================================================
% LOCAL FUNCTION
% Clamp
%% ========================================================================
function value = ...
    clampValue(value,limits)

value = ...
    max( ...
        limits(1), ...
        min( ...
            limits(2), ...
            value));

end



%% ========================================================================
% LOCAL FUNCTION
% 安全读取 cfg
%% ========================================================================
function value = ...
    getCfgValue(cfg,path,defaultValue)

value = ...
    defaultValue;


current = ...
    cfg;


for i = 1:numel(path)

    fieldName = ...
        path{i};


    if ~isstruct(current) ...
            || ...
            ~isfield(current,fieldName)

        return;

    end


    current = ...
        current.(fieldName);

end


value = ...
    current;

end