function jump=movingShockJump3D(upstream,gas,normal,normalSpeed)
%MOVINGSHOCKJUMP3D 同一上游下移动三维激波的Rankine-Hugoniot跃迁。
% 模块一：法向显式指向激波后流体，D为沿该法向的实验室系激波速度。
% 模块二：仅相对法向速度w1=V1·n-D进入正常压缩根；切向实验室速度连续。
% 模块三：回代[F·n-DQ]=0，实验室总焓变化为D*(V2n-V1n)，不能误用驻定H0。
assert(isa(normal,'double')&&isreal(normal)&&size(normal,2)==3&&size(normal,1)>0&& ...
    all(isfinite(normal),'all')&&all(abs(sum(normal.^2,2)-1)<1e-12), ...
    'ShockFit:Normal','需要指向激波后流体的真实单位法向，不自动归一化或翻转。');
N=size(normal,1);assert(isa(normalSpeed,'double')&&isreal(normalSpeed)&& ...
    isequal(size(normalSpeed),[N 1])&&all(isfinite(normalSpeed)),'ShockFit:ShockSpeed','D须为N×1有限法向速度。');
assert(isstruct(upstream)&&all(isfield(upstream,{'pressure','temperature','density','velocityVector','method'}))&& ...
    strlength(string(upstream.method))>0,'ShockFit:Upstream','需要有来源的均匀上游。');
validateattributes(upstream.velocityVector,{'double'},{'real','finite','size',[3 1]});
first=shockFittedState3D([upstream.density upstream.velocityVector' upstream.temperature],gas,'primitive');
assert(abs(first.pressure-upstream.pressure)<1e-10*upstream.pressure,'ShockFit:EOS','上游状态方程不一致。');
u1=repmat(upstream.velocityVector',N,1);un1=sum(u1.*normal,2);w1=un1-normalSpeed;
compression=shockLayerNormalJumpBatch(upstream,gas,w1);w2=compression.normalSpeed;
u2=u1+(w2-w1).*normal;
second=shockFittedState3D([compression.density u2 compression.temperature],gas,'primitive');
Q1=repmat(first.Q,N,1);Q2=second.Q;p1=repmat(first.pressure,N,1);p2=second.pressure;
F1=physicalFlux(Q1,u1,p1,normal)-normalSpeed.*Q1;
F2=physicalFlux(Q2,u2,p2,normal)-normalSpeed.*Q2;
scales=[upstream.density*w1, (p1+upstream.density*w1.^2).*ones(1,3), ...
    upstream.density*w1.*(abs(first.enthalpy)+w1.^2+sum(u1.^2,2)+normalSpeed.^2)];
relative=(F2-F1)./scales;
labHChange=second.totalEnthalpy-first.totalEnthalpy;expected=normalSpeed.*sum((u2-u1).*normal,2);
assert(max(abs(relative),[],'all')<5e-11&& ...
    max(abs(labHChange-expected)./max(1,abs(second.totalEnthalpy)))<5e-11, ...
    'ShockFit:JumpConservation','移动激波五量或实验室系能量关系未闭合。');
jump=struct('state',second,'normal',normal,'shockNormalSpeedMS',normalSpeed, ...
    'upstreamRelativeNormalSpeedMS',w1,'downstreamRelativeNormalSpeedMS',w2, ...
    'compression',compression,'upstreamALEFlux',F1,'downstreamALEFlux',F2,'conservationRelative',relative, ...
    'laboratoryTotalEnthalpyChange',labHChange,'expectedLaboratoryTotalEnthalpyChange',expected, ...
    'method','移动激波相对系同cp正常压缩根/三维切向连续；实验室系ALE五量回代', ...
    'stateLocation','给定移动激波紧后；不是壁面或边界层外缘', ...
    'shockShapeSolved',false,'bodyMatched',false,'heatFluxSolved',false,'wallTemperatureSolved',false, ...
    'productionQualified',false,'newProductionSolvedAreaM2',0);
end

function flux=physicalFlux(Q,u,p,n)
un=sum(u.*n,2);flux=[Q(:,1).*un Q(:,2:4).*un+p.*n (Q(:,5)+p).*un];
end
