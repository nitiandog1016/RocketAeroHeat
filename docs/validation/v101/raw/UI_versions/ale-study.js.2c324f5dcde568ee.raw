/* 模块用途：同一侧栏查看保存的模型/网格/边界/计算/结果；逐面探针不补造未知值。 */
'use strict';
(function(){
 const data=window.ALE_STUDY,$=id=>document.getElementById(id),buttons=[...document.querySelectorAll('[data-step]')];
 if(!data||data.kind!=='shock-fitted-kernel-study-v101'||data.productionQualified!==false||data.newProductionSolvedAreaM2!==0)throw Error('ALE研究身份无效。');
 const fields={pressurePa:['流体压力','Pa',[0,40000]],temperatureK:['流体温度','K',[80,2000]],speedMS:['速度幅值','m/s',[0,2000]],wallPressurePa:['Riemann壁压','Pa',[0,40000]],heatFluxWm2:['热流','W/m²',[0,1e6]],wallTemperatureK:['求解壁温','K',[80,2000]]},labels=['输入模型','生成网格','添加边界条件','计算','查看结果'];
 const fmt=v=>Number.isFinite(v)?Number(v.toPrecision(8)).toString():'未求解',kind=k=>['','储库侧面','移动/固定滑移壁面','移动激波 / 候选外壳'][k]||'原箭体';
 let selected=0,frame=1,step=4,view='all',field='pressurePa',face=0,revision=0,pickPosition=null;
 function rows(node,items){node.replaceChildren();items.forEach(([name,value])=>{const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=name;dd.textContent=String(value);node.append(dt,dd);});}
 function current(){return data.cases[selected];}
 function state(){const c=current(),f=c.frames[frame];if(view==='rocket')return{c,f,V:data.originalGeometry.vertices,F:data.originalGeometry.faces,map:data.originalGeometry.faces.map((_,i)=>i),full:true};const map=c.faces.map((_,i)=>i).filter(i=>view!=='wall'&&view!=='outer'||c.boundaryKind[i]===(view==='wall'?2:3));return{c,f,V:f.position,F:map.map(i=>c.faces[i]),map,full:false};}
 function value(s,key,index){return s.full?null:s.f[key][s.map[index]];}
 function center(s,index){const ids=s.F[index];return [0,1,2].map(j=>ids.reduce((t,i)=>t+s.V[i][j],0)/3);}
 function show(){
  const s=state();face=Math.max(0,Math.min(face,s.F.length-1));$('title').textContent=labels[step]+' · '+s.c.caption;$('scope').textContent=s.c.scope;$('gasScope').textContent=data.NASA7Scope;
  const detail=[['当前范围',s.F.length+' 个三角面'],['研究身份',s.c.stateRole],['数值核验',s.c.diagnostic],['正式新增热流面积','0 m²']];
  if(step===0)detail.unshift(['模型','保留原坐标与原面号；活塞为独立解析基准']);
  if(step===1)detail.unshift(['体网格','共享三角面的三维四面体，未复制轴对称剖面']);
  if(step===2)detail.unshift(['边界','储库 / 滑移壁面 / 移动激波；壁压由内部状态相容求得'],['壁温边界','本研究未设置']);
  if(step===3)detail.unshift(['计算入口','查看已保存结果；此页不启动新求解'],['未完成项','真实曲面激波与壁面同时闭合；黏性热流未求']);
  rows($('details'),detail);buttons.forEach((b,i)=>b.setAttribute('aria-selected',String(i===step)));
  $('frame').value=String(frame);$('time').textContent=(s.c.id==='piston'?'基准推进 t = ':'几何试验参数 t = ')+fmt(s.f.timeS)+' s · 仅初末实际保存帧';
  $('face').max=String(s.F.length-1);$('face').value=String(face);revision++;
  $('viewer').setAttribute('src','geometry/index.html?'+new URLSearchParams({case:String(selected),frame:String(frame),revision:String(revision),view,field,layer:step===4?'1':'0',wire:step===1?'1':'0'}));
  $('renderState').textContent='加载三维网格';probe();draw();
 }
 function probe(){
  const s=state(),index=s.map[face],id=s.full?index+1:s.c.sourceFaceIDs[index],xyz=pickPosition||center(s,face);
  $('role').textContent=s.c.stateRole;
  rows($('probe'),[['当前面元',face+1+' / '+s.F.length],['坐标 / m',xyz.map(fmt).join(', ')],['所属原箭面号',id>0?id:'基准面元，无原箭体对应'],['边界身份',s.full?'原整箭未求解面':kind(s.c.boundaryKind[index])],...Object.entries(fields).map(([key,[name,unit]])=>[name+' / '+unit,fmt(value(s,key,face))]),['外缘Te / 恢复Tr','未求 / 未求'],['给定壁温 / 求解壁温','未设置 / 未求']]);
  rows($('methods'),[['数据SHA256',data.source.evidenceSHA256],['适用范围',s.c.scope],...Object.keys(fields).map(key=>[fields[key][0]+'方法',s.full?'原箭体物理场未求':s.c.methods[key]]),['字段状态',Number.isFinite(value(s,field,face))?'已保存的限定基准数值':'未求解；不能用零替代'],['物理资格','研究验证；未授予真实箭体解资格']]);
 }
 function draw(){
  const canvas=$('curve'),s=state(),rect=canvas.getBoundingClientRect(),w=Math.max(300,rect.width),h=160,dpr=window.devicePixelRatio||1;canvas.width=w*dpr;canvas.height=h*dpr;const ctx=canvas.getContext('2d');ctx.scale(dpr,dpr);ctx.clearRect(0,0,w,h);ctx.fillStyle='#fff';ctx.fillRect(0,0,w,h);
  const [name,unit,range]=fields[field],left=58,right=w-18,top=22,bottom=126;ctx.strokeStyle='#c6d2de';ctx.beginPath();ctx.moveTo(left,top);ctx.lineTo(left,bottom);ctx.lineTo(right,bottom);ctx.stroke();ctx.fillStyle='#506779';ctx.font='11px system-ui';ctx.fillText(name+' / '+unit,left,13);ctx.fillText('面元序号',right-55,151);ctx.fillText(fmt(range[1]),2,top+4);ctx.fillText(fmt(range[0]),2,bottom+4);
  let drawing=false,known=0;ctx.strokeStyle='#256686';ctx.lineWidth=1.4;ctx.beginPath();s.F.forEach((_,i)=>{const v=value(s,field,i);if(!Number.isFinite(v)){drawing=false;return;}known++;const x=left+(right-left)*i/Math.max(1,s.F.length-1),y=bottom-(bottom-top)*(v-range[0])/(range[1]-range[0]);if(drawing)ctx.lineTo(x,y);else ctx.moveTo(x,y);drawing=true;});ctx.stroke();if(!known){ctx.fillStyle='#63768a';ctx.fillText('当前范围的此场量尚未求解',left+25,77);}
 }
 data.cases.forEach((c,i)=>{const o=document.createElement('option');o.value=String(i);o.textContent=c.caption;$('caseChoice').append(o);});
 buttons.forEach((b,i)=>b.addEventListener('click',()=>{step=i;pickPosition=null;show();}));
 $('caseChoice').addEventListener('change',()=>{const i=Number($('caseChoice').value);if(!Number.isInteger(i)||!data.cases[i])return;selected=i;frame=1;face=0;pickPosition=null;show();});
 $('view').addEventListener('change',()=>{if(!['all','wall','outer','rocket'].includes($('view').value))return;view=$('view').value;face=0;pickPosition=null;show();});
 $('field').addEventListener('change',()=>{if(!fields[$('field').value])return;field=$('field').value;show();});
 $('frame').addEventListener('input',()=>{const i=Number($('frame').value);if(!Number.isInteger(i)||!current().frames[i])return;frame=i;pickPosition=null;show();});
 $('face').addEventListener('input',()=>{const i=Number($('face').value);if(!Number.isInteger(i)||i<0||i>=state().F.length)return;face=i;pickPosition=null;probe();});
 window.addEventListener('message',event=>{const m=event.data;if(event.origin!==location.origin||event.source!==$('viewer').contentWindow||!m||m.kind!=='ale-view-event'||m.caseIndex!==selected||m.frameIndex!==frame||!m.payload||m.payload.revision!==revision)return;const p=m.payload;
  if(p.kind==='geometry-rendered'){$('renderState').textContent=p.webglError===0&&p.visiblePixelSamples>0?'三维网格已显示 · 可点选面元':'三维显示需要检查';return;}
  if(step!==4||p.kind!=='geometry-face-probe'||!Number.isInteger(p.faceIndex)||p.faceIndex<0||p.faceIndex>=state().F.length||!Array.isArray(p.barycentric)||p.barycentric.length!==3||p.barycentric.some(x=>!Number.isFinite(x)||x< -1e-9||x>1+1e-9)||Math.abs(p.barycentric.reduce((a,b)=>a+b,0)-1)>1e-9)return;
  face=p.faceIndex;const s=state();pickPosition=[0,1,2].map(j=>p.barycentric.reduce((v,t,i)=>v+t*s.V[s.F[face][i]][j],0));$('face').value=String(face);probe();
 });
 $('csv').addEventListener('click',()=>{const s=state(),quote=v=>'"'+(v==null?'':String(v)).replace(/"/g,'""')+'"';const header=['view_face_id','original_face_id','x_m','y_m','z_m','saved_time_s','pressure_Pa','fluid_temperature_K','speed_m_s','Riemann_wall_pressure_Pa','heat_flux_W_m2','solved_wall_temperature_K','edge_temperature_K','recovery_temperature_K','input_wall_temperature_K','state_role','pressure_method','temperature_method','heat_flux_status','production_qualified'];
  const lines=[header.map(quote).join(',')];s.F.forEach((_,i)=>{const index=s.map[i],id=s.full?index+1:s.c.sourceFaceIDs[index];const values=[i+1,id>0?id:null,...center(s,i),s.f.timeS,...Object.keys(fields).map(key=>value(s,key,i)),null,null,null,s.c.stateRole,s.full?'未求':s.c.methods.pressurePa,s.full?'未求':s.c.methods.temperatureK,'unknown',false];lines.push(values.map(quote).join(','));});const blob=new Blob(['\uFEFF'+lines.join('\n')+'\n'],{type:'text/csv;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='ale_'+current().id+'_'+view+'_frame'+frame+'.csv';a.click();URL.revokeObjectURL(url);
 });
 if(typeof ResizeObserver==='function')new ResizeObserver(draw).observe($('curve'));show();
})();
