function condition=schaeferFergusonCondition()
%SCHAEFERFERGUSONCONDITION 将原报告总温/单位Re换成当前理想气体引擎的静态来流。
% 模块一：710°R不是静温；按M4.98、gamma1.4作等熵总静换算。
% 模块二：由同一Sutherland粘度及单位Re反求密度/压力；这是物性假设，不是实测静压。
% 模块三：压力取绝热研究边界；热流比较必须另给配对空间Tw，不复用本边界零热流。
M=4.98;T0=710*5/9;gamma=1.4;R=287.05287;unitRe=1.6e6/.3048;
T=T0/(1+(gamma-1)*M^2/2);mu=1.458e-6*T^1.5/(T+110.4);a=sqrt(gamma*R*T);
U=M*a;rho=unitRe*mu/U;p=rho*R*T;
atmosphere=struct('gamma',gamma,'R',R,'temperature',T,'pressure',p,'density',rho, ...
    'speedOfSound',a,'dynamicViscosity',mu,'kinematicViscosity',mu/rho);
condition=struct('Mach',M,'totalTemperature',T0,'unitReynolds',unitRe,'diameterReynolds',unitRe*1.8*.0254, ...
    'atmosphere',atmosphere,'alpha',0,'beta',0,'wallThermalMode','adiabatic', ...
    'source','Schaefer/Ferguson 1961, figure8/11 low-Re 10deg group', ...
    'staticStateMethod','ideal gas gamma1.4 total-to-static; density inferred using Sutherland and unit Reynolds', ...
    'gasModelQualifiedAtThisTemperature',false,'experimentalComparisonPerformed',false, ...
    'pressureScope','equilibrium near-adiabatic; low-Re separation fairing is not independent measured points', ...
    'heatScope','transient nonuniform Tw; digitized paired temperature/heat data required');
end
