function [direction,report,config]=loadRocketSteadyDirectionGuess(config,Q,cut,gas,boundary,scale)
%LOADROCKETSTEADYDIRECTIONGUESS 仅复用同基态的数值方向，不复用旧导数或给予接受资格。
% 模块一：来源必须是未提交更新的同Q检查点，几何/边界/气体/缩放逐项绑定。
% 模块二：方向可作显式正倍数初猜；当前模型重新形成剩余，最后总方向仍须原NS复核。
assert(isstruct(config)&&isscalar(config)&&isequal(sort(fieldnames(config)),sort({'file';'variant';'scale'})), ...
    'SteadyGuess:Config','初猜必须显式提供file、variant及scale。');
assert(ischar(config.file)&&isfile(config.file)&&ischar(config.variant)&&ismember(config.variant,{'result','limited'}), ...
    'SteadyGuess:File','初猜来源或保存变量非法。');
validateattributes(config.scale,{'numeric'},{'real','finite','scalar','positive'});
s=load(config.file,config.variant,'gas','boundary');assert(all(isfield(s,{config.variant,'gas','boundary'})),'SteadyGuess:File','来源缺少状态或边界物性。');r=s.(config.variant);
assert(isequaln(r.initialQ,Q)&&isequaln(r.Q,Q)&&r.acceptedNonlinearIterations==0&& ...
    isequaln(r.residualScale,scale)&&isequaln(s.gas,gas)&&isequaln(s.boundary,boundary), ...
    'SteadyGuess:State','初猜不属于当前未更新基态、缩放、气体或边界。');
assert(strcmp(r.linearEquation,'steady-newton')&&r.originalNSCombinedDirectionCheckPreserved&&~isempty(r.linearLog)&& ...
    isfield(r.options,'coarseOperatorFile')&&isfile(r.options.coarseOperatorFile),'SteadyGuess:Source','缺少明确的原NS稳态方向或几何来源。');
e=r.linearLog{end}.steadyDirectionEvidence;
assert(e.baseAcceptedIteration==0&&isequal(size(e.directionU),size(Q))&&isreal(e.directionU)&&all(isfinite(e.directionU),'all'), ...
    'SteadyGuess:Direction','初猜方向不对应来源基态或数值非法。');
coarseFile=r.options.coarseOperatorFile;t=load(coarseFile,'coarse');c=t.coarse;
assert(isequaln(c.baseQ,Q)&&isequaln(c.space.geometry,cut)&&isequaln(c.gas,gas)&&isequaln(c.boundary,boundary)&& ...
    isequaln(c.scale,scale)&&isequaln(c.sourceIdentity,rocketSelectedDirectionSourceIdentity), ...
    'SteadyGuess:Geometry','初猜几何、物性边界、缩放或计算来源不符。');
direction=double(config.scale)*e.directionU;assert(all(isfinite(direction),'all'),'SteadyGuess:Direction','缩放初猜溢出。');
report=struct('sourceFile',config.file,'sourceVariant',config.variant,'directionScale',config.scale, ...
    'sourceFileSHA256',rocketStreamingFileSHA256(config.file),'sourceCoarseFile',coarseFile, ...
    'sourceCoarseFileSHA256',rocketStreamingFileSHA256(coarseFile),'sourceStateAndGeometryVerified',true, ...
    'sourceSavedActualNSRelativeDefect',r.linearLog{end}.fullSystemRelativeDefect,'oldDerivativeReused',false, ...
    'newModelApplications',0,'newActualNSEvaluations',0,'originalNSAcceptanceClaimed',false);
end
