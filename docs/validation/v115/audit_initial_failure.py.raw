"""独立核对逐节点温度、原生热梯度、原面映射及CSV，不把输入适配授予物理资格。"""
from pathlib import Path
import csv,hashlib,json,sys
import numpy as np
from scipy.io import loadmat
from scipy.spatial import cKDTree
ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT/'tests'))
from auditSU2V110 import vtk_tokens
def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def read(p):return json.loads(p.read_text(encoding='utf-8-sig'))
def mat(p):return loadmat(str(p),squeeze_me=True,struct_as_record=False)
def main():
    out=ROOT/'outputs/v115_validation';actual=out/'actual01';target=out/'independent_audit.json';assert not target.exists()
    info=read(actual/'report.json');folder=Path(info['engineFolder']);r=mat(actual/'spatial_result.mat')['r']
    mesh=mat(ROOT/info['reusedMeshFolder']/'hybrid_volume.mat');V=mesh['vertices'];F=mesh['sourceFaces'].astype(int)-1
    nw=len(mesh['sourceVertices']);assert len(F)==3648 and nw==1826
    manifest=read(folder/'case_manifest.json');spec=manifest['thermalBoundary']['specification']
    given=np.interp(V[:nw,0],spec['x'],spec['temperature'])
    with (folder/'rah_wall_temperature_applied.csv').open() as f:rows=list(csv.DictReader(f))
    ids=np.array([int(q['globalNodeID']) for q in rows]);temp=np.array([float(q['givenTemperature_K']) for q in rows])
    assert np.array_equal(np.sort(ids),np.arange(nw)) and max(abs(temp-given[ids]))<1e-12
    xyz,fields=vtk_tokens(folder/'surface_flow.vtk');distance,order=cKDTree(V[:nw]).query(xyz)
    assert max(distance)<1e-6 and len(set(order))==nw
    vals=np.zeros((nw,3));vals[order]=np.column_stack([fields[k][:,0] for k in ('Pressure','Heat_Flux','Temperature')])
    mapped=vals[F].mean(axis=1)
    for j,key in enumerate(['pressureRaw','heatFluxRaw','fluidNodeTemperatureMeanRaw']):assert np.allclose(mapped[:,j],getattr(r,key),rtol=1e-12,atol=1e-8)
    assert np.max(abs(given[F].mean(axis=1)-r.wallTemperatureInput))<1e-12
    # 独立按原三角面积合成内向流体法向，再从棱柱真实边邻点中选择最大方向余弦。
    normal=np.zeros((nw,3));neighbors=[set() for _ in range(nw)]
    area=np.cross(V[F[:,1]]-V[F[:,0]],V[F[:,2]]-V[F[:,0]])/2
    for j in range(3):np.add.at(normal,F[:,j],area/3)
    W=mesh['wedges'].astype(int)-1
    for a,b in [(0,1),(1,2),(2,0),(3,4),(4,5),(5,3),(0,3),(1,4),(2,5)]:
        for i,j in W[:,[a,b]]:
            if i<nw:neighbors[i].add(j)
            if j<nw:neighbors[j].add(i)
    near=[]
    for i,js in enumerate(neighbors):
        js=np.array(sorted(js));delta=V[js]-V[i];cos=delta.dot(normal[i])/np.linalg.norm(delta,axis=1)
        near.append(js[np.argmax(cos)])
    near=np.array(near);assert (near>=nw).all()
    rest=np.loadtxt(str(folder/'restart_flow.csv'),delimiter=',',skiprows=1)
    assert np.array_equal(rest[:,0],np.arange(len(V))) and np.max(abs(rest[:,1:4]-V))<1e-14
    rho=rest[:,4];vel=rest[:,5:8]/rho[:,None];T=(rest[:,8]/rho-(vel*vel).sum(axis=1)/2)*.4/287.05287
    assert (rho>0).all() and (T>0).all()
    distance=np.linalg.norm(V[near]-V[:nw],axis=1);mu=1.458e-6*T[:nw]**1.5/(T[:nw]+110.4)
    q=mu*(1.4*287.05287/.4)/.72*(T[near]-given)/distance
    error=float(np.max(abs(q-vals[:,1])/np.maximum(1,abs(q))))
    assert error<2e-6,'真实热梯度与空间壁温不一致'
    assert np.array_equal(np.sign(vals[:,1]),np.sign(T[near]-given))
    scalarWrong=mu*(1.4*287.05287/.4)/.72*(T[near]-100)/distance
    wrongError=float(np.max(abs(scalarWrong-vals[:,1])/np.maximum(1,abs(vals[:,1]))));assert wrongError>.01
    comparison=read(actual/'constant_comparison.json');assert max(comparison['maximumNormalizedDifferences'])<comparison['threshold']
    _,constant=vtk_tokens(actual/'native_constant/surface_flow.vtk')
    delta=float(np.max(abs(constant['Heat_Flux'][:,0]-fields['Heat_Flux'][:,0])));assert delta>1
    table=np.genfromtxt(str(actual/'fields.csv'),delimiter=',',names=True)
    assert len(table)==len(F) and np.array_equal(table['originalFaceID'],np.arange(1,len(F)+1))
    assert not table['productionQualified'].any() and not table['heatFluxIsBoundaryInput'].any()
    assert np.isnan(table['solvedWallTemperature_K']).all()
    for key,ref in [('pressureRaw_Pa',r.pressureRaw),('heatFluxRaw_W_m2',r.heatFluxRaw),('givenWallTemperature_K',r.wallTemperatureInput)]:
        assert np.allclose(table[key],ref,rtol=2e-14,atol=1e-12)
    sections={}
    for name,expected,status in [('wall_section.csv',r.wallTemperatureInput,'给定条件'),('heat_section.csv',r.heatFluxRaw,'研究计算值')]:
        with (actual/name).open(encoding='utf-8-sig',newline='') as f:rows=list(csv.DictReader(f))
        valueKey=next(k for k in rows[0] if ' / K' in k or ' / W/m' in k)
        idKey=next(k for k in rows[0] if '面元' in k and 'ID' in k)
        for row in rows:
            assert status in row['状态'];assert abs(float(row[valueKey])-expected[int(row[idKey])-1])<1e-8
        sections[name]=len(rows)
    receipt=read(folder/'engine_process.json');assert receipt['status']=='terminal' and receipt['exitCode']==0
    assert all(receipt['inputsStable'].values()) and not r.productionQualified
    for name,h in receipt['outputSHA256'].items():assert sha(folder/name)==h
    paths=[Path(__file__).resolve(),ROOT/'tests/auditSU2V110.py',actual/'spatial_result.mat',actual/'fields.csv',actual/'wall_section.csv',actual/'heat_section.csv']
    paths += [folder/n for n in ['case.cfg','mesh.su2','case_manifest.json','wall_temperature.csv','rah_wall_temperature_applied.csv','surface_flow.vtk','restart_flow.csv','engine_process.json']]
    report=dict(wallNodes=nw,originalFaces=len(F),nativeGradientMaximumRelativeDifference=error,
        constantFallbackCounterexampleRelativeError=wrongError,variableVsConstantMaximumHeatDifferenceWm2=delta,
        positiveIntoWallSignVerified=True,constantComparison=comparison,sections=sections,
        engineSeconds=receipt['elapsedSeconds'],profileRangeK=[float(given.min()),float(given.max())],
        physicsQualified=False,newQualifiedArea=0,inputSHA256={p.relative_to(ROOT).as_posix():sha(p) for p in paths})
    target.write_text(json.dumps(report,indent=2)+'\n',encoding='utf-8');print(json.dumps({k:v for k,v in report.items() if k!='inputSHA256'}))
if __name__=='__main__':main()
